. local r=1 

. while `r'<16 {
  2. local s=`r'+1849
  3. rename year`r' yr`s'
  4. local r=`r'+1
  5. }

. 
. **
. foreach y of varlist    Zeng_all0_invdist Zeng_all0 Zeng_all0_invdist_pc Zeng_all0_pc{
  2. foreach x of varlist yr1850-yr1852 yr1854-yr1864 {
  3. gen `y'_`x'=`y'*`x'
  4. }
  5. }

. 

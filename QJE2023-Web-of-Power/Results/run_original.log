  5.     capture noisily do "Program/`s'.do"
  6.     local rc = _rc
  7.     timer off 1
  8.     quietly timer list 1
  9.     local secs = r(t1)
 10.     capture restore
 11.     quietly cd "`root'"
 12.     graph close _all
 13.     di as res "==> STEP `s' finished: rc=`rc'  seconds=" %9.1f `secs'
 14.     file write `fh' "`s',`rc'," %9.1f (`secs') _n
 15. }


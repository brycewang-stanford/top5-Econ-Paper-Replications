. *****************************************************************************
> ***
. *************      Make Figure, mass over time         **********************
> ***
. *****************************************************************************
> ***
. *The following two program requires stored estimation results to be called.
.  
.  
.                         *****************************************************
> ***************
.                         ****************      Before               **********
> ***************
.                         *****************************************************
> ***************
.  
. cap program drop makefigure_massovertime_before

. program define makefigure_massovertime_before
  1. syntax , [Tmin(real 12) Tmax(real 16)]
  2. 
.                                 
.                                 foreach t of numlist -`tmin'(4)-4 {
  3.                         
.                         
.                                         local nt = -`t'
  4.                                         nlcom ("${aboveF`nt'}") 
  5.                                         mat b = r(b)
  6.                                         mat V = r(V)
  7.                                         local ab = b[1,1]*(4)*(1/${E})
  8.                                         local ase = sqrt(V[1,1])*(4)*(1/${
> E})
  9.                                         nlcom ("${belowF`nt'}") 
 10.                                         mat b = r(b)
 11.                                         mat V = r(V)
 12.                                         local bb =  (b[1,1]*(4))*(1/${E})
 13.                                         local bse = sqrt(V[1,1])*(4)*(1/${
> E})
 14. 
.                                         if `nt' == `tmin' {
 15.                                                 mat eventmat = [`t', `ab',
>  `ab'-1.96*`ase', `ab'+1.96*`ase',  `bb', `bb'-1.96*`bse', `bb'+1.96*`bse'] 
 16.                                         }
 17.                                         else {
 18.                                                 mat eventmat = [eventmat \
>  [`t', `ab', `ab'-1.96*`ase', `ab'+1.96*`ase',  `bb', `bb'-1.96*`bse', `bb'+1
> .96*`bse']] 
 19.                                         }
 20. }
 21. *
. 
. end

.                                         
.                                         
. 
.                                         *************************************
> ***********************
.                                         *******************     After        
>      ******************
.                                         *************************************
> ***********************
.                                         
.                                         
. cap program drop makefigure_massovertime_after

. program define makefigure_massovertime_after
  1. syntax , [Tmin(real 12) Tmax(real 16)]
  2.                                         
. 
.                                 foreach t of numlist 0(4)`tmax' {
  3.                                         nlcom ("${aboveL`t'}") 
  4.                                         mat b = r(b)
  5.                                         mat V = r(V)
  6.                                         local ab =  b[1,1]*(4)*(1/${E})
  7.                                         local ase = sqrt(V[1,1])*(4)*(1/${
> E})
  8.                                         nlcom ("${belowL`t'}") 
  9.                                         mat b = r(b)
 10.                                         mat V = r(V)
 11.                                         local bb =  (b[1,1]*(4))*(1/${E})
 12.                                         local bse = sqrt(V[1,1])*(4)*(1/${
> E})
 13.                                         mat eventmat = [eventmat \ [`t', `
> ab', `ab'-1.96*`ase', `ab'+1.96*`ase',  `bb', `bb'-1.96*`bse', `bb'+1.96*`bse
> '] ]
 14. 
.                                         }
 15.                         
.                         cap drop time* 
 16.                         cap drop est* 
 17.                         cap drop low* high* 
 18.                         cap drop _est*
 19.                         
.                         cap drop eventmat*
 20.                         cap drop bunchest
 21.                         
.                         svmat eventmat
 22.                         rename eventmat1 time
 23.                         rename eventmat2 estA                   
 24.                         rename eventmat3 lowA
 25.                         rename eventmat4 highA
 26.                         rename eventmat5 estB                   
 27.                         rename eventmat6 lowB
 28.                         rename eventmat7 highB
 29.  
.                                 twoway ( line estA time  , fcolor(ltblue) lco
> lor(ltblue)  lwidth(thick)  ) ///
>                                 (rcap lowA  highA time  , lwidth(thick) lcolo
> r(ltblue*1.25) )  ///
>                                 ( line estB time  , fcolor(red) lcolor(red) l
> width(thick) yline(0, lcolor(gs10) lwidth(vvthin)) xline(0, lpattern(dash) lc
> olor(black) ) ) ///
>                                 (rcap lowB  highB time  , lwidth(thick)  lcol
> or(red*1.25) ) , ///
>                                 scheme(s1color) xtitle("Annualized event time
> ", size(medsmall)) ///
>                                 /*ytitle("Excess mass", height(5) axis(1) siz
> e(medsmall))*/   ///
>                                  ylabel(, axis(1) labsize(medsmall)) yscale(t
> itlegap(0) axis(1))  ///
>                                 /*xlabel(-12 "[-12,-9]" -8 "[-8,-5]" -4 "[-4,
> -1]" 0 "[0,3]" 4 "[4,7]" 8 "[8,11]" 12 "[12,15]" 16 "[16,19]", labsize(medsma
> ll)) */ ///
>                                 xlabel(-12 "-3" -8 "-2" -4 "-1" 0 "0" 4 "1" 8
>  "2" 12 "3" 16 "4", labsize(medsmall)) legend(off) /* ///
>                                 title("${label`s'}", size(medium) )  note("$b
> unchch" "$bunchelas" "$belowmasssh" "$abovemasssh"  /*"$elastest"*/, size(sma
> ll) color(blue)) ///
>                                 */
 30.  
. end 


>       *********
.                         *****************************************************
> ***************
. 
.  global treatafterm400 ""
  5.  global treatafterm200 ""
  6.  global treatafterp0 ""
  7.  global treatafterp250 ""
  8. 
. foreach vv in 400 200{
  9. forval k = 0(4)`tmax'   {
 10.         local temp = `vv' -200 + 25
 11.         if `k' == 0 {
 12.                 local K  ""
 13.         }       
 14.         
.         if `k' > 0 {
 15.                 local K  "L`k'"
 16.         }       
 17.         
.         
.         foreach j of numlist `vv'(`wincrement')`temp'      {
 18.                 global treatafterm`vv' = "${treatafterm`vv'} `K'treat_m`j'
> "
 19.         }
 20.         }
 21. }
 22. * 
. 
. foreach vv in 0 250{
 23. forval k = 0(4)`tmax'   {
 24.         local temp = `vv' +250 - 25
 25.         if `k' == 0 {
 26.                 local K  ""
 27.         }       
 28.         
.         if `k' > 0 {
 29.                 local K  "L`k'"
 30.         }       
 31.         
.         
.         foreach j of numlist `vv'(`wincrement')`temp'      {
 32.                 global treatafterp`vv' = "${treatafterp`vv'} `K'treat_p`j'
> "
 33.         }
 34.         }
 35. }
 36. * 
. 
.  
. global controlafterm400 " " 
 37. global controlafterm200 " " 
 38. global controlafterp0 " " 
 39. global controlafterp250 " " 
 40. 
. foreach vv in 400 200{
 41. forval k = 0(4)`tmax'   {
 42.         if `k' < 0 {
 43.                 local nk = -`k'
 44.                 local K  "F`nk'"
 45.         }       
 46.         local temp = `vv' -200 + 25
 47.         
.         if `k' == 0 {
 48.                 local K  ""
 49.         }       
 50.         
.         if `k' > 0 {
 51.                 local K  "L`k'"
 52.         }       
 53.         
.         
.         foreach j of numlist `vv'(`wincrement')`temp'       {
 54.                 global controlafterm`vv' = "${controlafterm`vv'} i.one#c.`
> K'treat_m`j'"
 55.         }
 56.         }
 57. }
 58. *
. foreach vv in 0 250{
 59. forval k = 0(4)`tmax'   {
 60.         if `k' < 0 {
 61.                 local nk = -`k'
 62.                 local K  "F`nk'"
 63.         }       
 64.         local temp = `vv' + 250 - 25
 65.         
.         if `k' == 0 {
 66.                 local K  ""
 67.         }       
 68.         
.         if `k' > 0 {
 69.                 local K  "L`k'"
 70.         }       
 71.         
.         
.         foreach j of numlist `vv'(`wincrement')`temp'       {
 72.                 global controlafterp`vv' = "${controlafterp`vv'} i.one#c.`
> K'treat_p`j'"
 73.         }
 74.         }
 75. }
 76. * 
. global controlbefore " "
 77. forval k = -`tmin'(4)-8   {
 78. if `k'!=-4{
 79.         if `k' < 0 {
 80.                 local nk = -`k'
 81.                 local K  "F`nk'"
 82.         }       
 83.         
.         
.         if `k' == 0 {
 84.                 local K  ""
 85.         }       
 86.         
.         if `k' > 0 {
 87.                 local K  "L`k'"
 88.         }       
 89.         
.         
.         foreach j of numlist `wmincent'(`wincrement')`wincrement'       {
 90.                 global controlbefore = "$controlbefore i.one#c.`K'treat_m`
> j'"
 91.         }
 92.         foreach j of numlist  0(`wincrement')`wmaxcent2' {
 93.                 global controlbefore = "$controlbefore i.one#c.`K'treat_p`
> j'"
 94.         }
 95.         }
 96.         
. }
 97. 
. 
. global window " "
 98.         
.         foreach j of numlist `wmincent'(`wincrement')`wincrement'       {
 99.                 global window = "$window i.one##c.window_m`j' "
100.         }
101.         foreach j of numlist  0(`wincrement')`wmaxcent2' {
102.                 global window = "$window i.one##c.window_p`j' "
103.         }
104. 
. 
. 
. end


. cap program drop abovebelowfull

. program define abovebelowfull
  1. syntax [, Tmax(real 16)]
  2. di "Make sure that belowL`tmax' and aboveL`tmax' exists. Otherwise the pro
> gram does not work. Assertion will be false."
  3. assert  "${belowL`tmax'}"!=""
  4. assert  "${aboveL`tmax'}"!=""
  5.  
. global above_full "${aboveL0}"
  6. global below_full "${belowL0}"
  7. 
. forval t = 4(4)`tmax' {
  8.                         
.                                 global below_full "${below_full} + ${belowL`t
> '}"
  9.                                 global above_full "${above_full} + ${above
> L`t'}"
 10.  }
 11. 
.  end


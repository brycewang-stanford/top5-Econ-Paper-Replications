  1. syntax , Y(string) [Tmin(real 12) Tmax(real 16) Wmax(real 4) Wmin(real 4)]
  2. 
. 
. 
. 
.                                 foreach t of numlist -`tmin'(4)`tmax' {
  3.                                 
.                                                 if `t' < -4  {  
  4.                                                         local nt = -`t' 
  5.                                                         global aboveWBF`nt
> '`y' "((_b[F`nt'treat`y'_p0])*(${wagemult`y'}+0) )"
  6.                                                 forval j = 1/`wmax' {
  7.                                                         global aboveWBF`nt
> '`y' "${aboveWBF`nt'`y'} + ((_b[F`nt'treat`y'_p`j'])*(${wagemult`y'}+`j') )"
  8.                                                 }
  9.                                                 global belowWBF`nt'`y' "((
> _b[F`nt'treat`y'_m1])*(${wagemult`y'}-1) )"
 10.                                                 forval j = 2/`wmin' {
 11.                                                         global belowWBF`nt
> '`y' "${belowWBF`nt'`y'} + ((_b[F`nt'treat`y'_m`j'])*(${wagemult`y'}-`j') )"
 12.                                                 }
 13. 
.                                         }
 14. 
.                                 
. 
.                                         if `t' == 0 {   
 15.                  

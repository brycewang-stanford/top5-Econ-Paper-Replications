. *****************************************************************************
> ***
. ******    Above and Below Bunches for Quantiles and Persistent Events     ***
> ***
. *****************************************************************************
> ***
. 
. 
. cap program drop abovebelowqpersbunch

. program define abovebelowqpersbunch
  1. syntax ,  [Tmin(real 12) Tmax(real 16) Wmax(real 4) Wmin(real 4)]
  2. 
. foreach y in pers q{
  3. foreach t of numlist -`tmin'(4)`tmax' {
  4. 
.         if `t' < -4  {  
  5.                 local nt = -`t' 
  6.                 global aboveF`nt'`y' "(_b[F`nt'treat`y'_p0] )"
  7.                 forval j = 1/`wmax' {
  8.                         global aboveF`nt'`y' "${aboveF`nt'`y'} + (_b[F`nt'
> treat`y'_p`j'] )"
  9.                 }
 10.                 global belowF`nt'`y' "(_b[F`nt'treat`y'_m1] )"
 11.                 forval j = 2/`wmin' {
 12.                         global belowF`nt'`y' "${belowF`nt'`y'} + (_b[F`nt'
> treat`y'_m`j'] )"
 13.                 }
 14. 
.     }
 15.  
.         if `t' == -4 {
 16.                 global aboveF4`y' "0"
 17.                 global belowF4`y' "0"
 18.         }
 19.  
.         if `t' == 0 {   
 20.                  
.                 global aboveL`t'`y' "(_b[treat`y'_p0])"
 21.                 forval j = 1/`wmax' {
 22.                         global aboveL`t'`y' "${aboveL`t'`y'} + (_b[treat`y
> '_p`j'] )"
 23.                 }
 24.                 global belowL`t'`y' "(_b[treat`y'_m1] )"
 25.                 forval j = 2/`wmin' {
 26.                         global belowL`t'`y' "${belowL`t'`y'} + (_b[treat`y
> '_m`j'])"
 27.                 }
 28. 
.     }
 29.         
.    if `t' > 0 { 
 30.                  
.                 global aboveL`t'`y' "(_b[L`t'treat`y'_p0])"
 31.                 forval j = 1/`wmax' {
 32.                         global aboveL`t'`y' "${aboveL`t'`y'} + (_b[L`t'tre
> at`y'_p`j'])"
 33.                 }
 34.                 global belowL`t'`y' "(_b[L`t'treat`y'_m1] )"
 35.                 forval j = 2/`wmin' {
 36.                         global belowL`t'`y' "${belowL`t'`y'} + (_b[L`t'tre
> at`y'_m`j'] )"
 37.                 }
 38. 
.     }
 39.         
.  
.  } 
 40.  }
 41.  *
. end 


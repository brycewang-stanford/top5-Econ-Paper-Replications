> reat`y'_p0])*(${wagemult`y'}+0))"
 16.                                                 forval j = 1/`wmax' {
 17.                                                         global aboveWBL`t'
> `y' "${aboveWBL`t'`y'} + ((_b[treat`y'_p`j'])*(${wagemult`y'}+`j') )"
 18.                                                 }
 19.                                                 global belowWBL`t'`y' "((_
> b[treat`y'_m1])*(${wagemult`y'}-1) )"
 20.                                                 forval j = 2/`wmin' {
 21.                                                         global belowWBL`t'
> `y' "${belowWBL`t'`y'} + ((_b[treat`y'_m`j'])*(${wagemult`y'}-`j') )"
 22.                                                 }
 23. 
.                                         }
 24.         
.                                         if `t' > 0 {    
 25.                  
.                                                 global aboveWBL`t'`y' "((_b[L
> `t'treat`y'_p0])*(${wagemult`y'}+0))"
 26.                                                 forval j = 1/`wmax' {
 27.                                                         global aboveWBL`t'
> `y' "${aboveWBL`t'`y'} + ((_b[L`t'treat`y'_p`j'])*(${wagemult`y'}+`j'))"
 28.                                                 }
 29.                                                 global belowWBL`t'`y' "((_
> b[L`t'treat`y'_m1])*(${wagemult`y'}-1) )"
 30.                                                 forval j = 2/`wmin' {
 31.                                                         global belowWBL`t'
> `y' "${belowWBL`t'`y'} + ((_b[L`t'treat`y'_m`j'])*(${wagemult`y'}-`j'))"
 32.                                                 }
 33. 
.                                         }
 34.         
.  
.                         } 
 35.                         global aboveWBF4`y' = 0
 36.                         global belowWBF4`y' = 0
 37. 
.                         
. end                     


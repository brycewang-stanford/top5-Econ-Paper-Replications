. program define abovebelowbunch
  1. syntax [,Tmin(real 12) Tmax(real 16) Wmax(real 4) Wmin(real 4)]
  2. 
. foreach t of numlist -`tmin'(4)`tmax' {
  3. 
.         if `t' < -4  {  
  4.                 local nt = -`t' 
  5.                 global aboveF`nt' "(_b[F`nt'treat_p0] )"
  6.                 forval j = 1/`wmax' {
  7.                         global aboveF`nt' "${aboveF`nt'} + (_b[F`nt'treat_
> p`j'] )"
  8.                 }
  9.                 global belowF`nt' "(_b[F`nt'treat_m1] )"
 10.                 forval j = 2/`wmin' {
 11.                         global belowF`nt' "${belowF`nt'} + (_b[F`nt'treat_
> m`j'] )"
 12.                 }
 13. 
.     }
 14.  
.         if `t' == -4 {
 15.                 global aboveF4 "0"
 16.                 global belowF4 "0"
 17.         }
 18.  
.         if `t' == 0 {   
 19.                  
.                 global aboveL`t' "(_b[treat_p0])"
 20.                 forval j = 1/`wmax' {
 21.                         global aboveL`t' "${aboveL`t'} + (_b[treat_p`j'] )
> "
 22.                 }
 23.                 global belowL`t' "(_b[treat_m1] )"
 24.                 forval j = 2/`wmin' {
 25.                         global belowL`t' "${belowL`t'} + (_b[treat_m`j'] )
> "
 26.                 }
 27. 
.     }
 28.         
.    if `t' > 0 { 
 29.                  
.                 global aboveL`t' "(_b[L`t'treat_p0])"
 30.                 forval j = 1/`wmax' {
 31.                         global aboveL`t' "${aboveL`t'} + (_b[L`t'treat_p`j
> '])"
 32.                 }
 33.                 global belowL`t' "(_b[L`t'treat_m1])"
 34.                 forval j = 2/`wmin' {
 35.                         global belowL`t' "${belowL`t'} + (_b[L`t'treat_m`j
> '])"
 36.                 }
 37. 
.     }
 38.         
.  
.  } 
 39.  *
. end


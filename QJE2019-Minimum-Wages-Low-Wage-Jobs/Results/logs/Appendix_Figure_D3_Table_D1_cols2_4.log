 17. }
 18. **************************************************************************
> ******
. 
. if "`federal'"=="Y" & "`small'"==""  & "`restriction'" == ""{
 19. di "You are using the working data with federal MW changes counted as even
> ts."
 20. use "${data}state_panels_with3quant1979_statefed.dta",clear
 21. global controlf " "
 22. }
 23. **************************************************************************
> ******
. if "`federal'"=="Y" & "`small'"=="Y"  & "`restriction'" == ""{
 24. di "You are counting all MW increases as events."
 25. 
. use "${data}state_panels_with3quant1979.dta",clear
 26. local treatdef1 "D.MW_real> 0  & D.MW_real<.& D.MW>0"                     
>                               // Every real increase in MW is considered as t
> reatment.
 27. global controlf " "
 28. global control " "
 29. 
. 
. forval k = 0/5  {
 30.         cap drop treat_p`k' 
 31.         cap drop _treat_p`k'
 32.         g _treat_p`k'=0
 33.         * replace _treat_p`k' = 1 if (  D.MW_real<. & D.MW>0) &  (wageM25>
> =(MW_realM25+`k') &  wageM25 < (MW_realM25 +1 +`k'))  
.         *       replace _treat_p`k' = 1 if (D.MW_real > 0  & D.MW_real<. & D.
> MW>0) &  (wageM25>=(MW_realM25+`k') &  wageM25 < (MW_realM25 +1 +`k'))
.                 replace _treat_p`k' = 1 if `treatdef1' &  (wageM25>=(MW_realM
> 25+`k' - 0.25) &  wageM25 < (MW_realM25 +1 +`k' - 0.25)) 
 34.         *       replace _treat_p`k' = 1 if (D.MW_real>=0.75  & D.MW_real<.
>  & D.MW>0) &  (wageM25>=(MW_realM25+`k') &  wageM25 < (MW_realM25 +1 +`k'))
.          g treat_p`k' = ( _treat_p`k' +  L._treat_p`k' + L2._treat_p`k' + L3.
> _treat_p`k')
 35.         cap drop _treat_p`k'
 36. 
. }
 37. 
. forval k = 1/5  {
 38.         cap drop treat_m`k'
 39.         cap drop _treat_m`k'
 40.         g _treat_m`k'=0
 41.         *       replace _treat_m`k' = 1 if ( D.MW_real<.& D.MW>0) & (wageM
> 25<(MW_realM25 - `k' + 1)  &  wageM25 >= (MW_realM25 -`k' ))
.         *       replace _treat_m`k' = 1 if(D.MW_real> 0  & D.MW_real<.& D.MW>
> 0) & (wageM25<(MW_realM25 - `k' + 1)  &  wageM25 >= (MW_realM25 -`k' ))
.                 replace _treat_m`k' = 1 if `treatdef1' & (wageM25<(MW_realM25
>  - `k' + 1 -0.25)  &  wageM25 >= (MW_realM25 -`k' -0.25 )) 
 42.         *       replace _treat_m`k' = 1 if(D.MW_real>=0.75  & D.MW_real<.&
>  D.MW>0) & (wageM25<(MW_realM25 - `k' + 1)  &  wageM25 >= (MW_realM25 -`k' ))
.         g treat_m`k' = ( _treat_m`k' + L._treat_m`k' + L2._treat_m`k' + L3._t
> reat_m`k' )
 43. cap drop _treat_m`k'
 44. }  
 45. *
. 
.  cap drop  Dtreat_p0
 46.  g Dtreat_p0 = D.treat_p0 
 47. 
. *Leads and Lags
.  
. foreach j in  4 8 12 16 {
 48.         foreach k in m5 m4 m3 m2 m1 p0 p1 p2 p3 p4 p5 {
 49.                 cap drop F`j'treat_`k'
 50.                 cap drop L`j'treat_`k'
 51.                 
.                 g F`j'treat_`k' = F`j'.treat_`k'
 52.                 g L`j'treat_`k' = L`j'.treat_`k'
 53. 
.         }
 54. } 
 55. 
. cap drop window_*
 56. foreach pm in p m{
 57.         foreach num of numlist 1(1)5{
 58.                 gen window_`pm'`num' =  F12treat_`pm'`num' +  F8treat_`pm'
> `num' +  F4treat_`pm'`num' + treat_`pm'`num' + L4treat_`pm'`num'  + L8treat_`
> pm'`num'  + L12treat_`pm'`num'  + L16treat_`pm'`num'  
 59.         }
 60. }
 61. 
. local pm p
 62. local num 0
 63. gen window_`pm'`num' =  F12treat_`pm'`num' +  F8treat_`pm'`num' +  F4treat
> _`pm'`num' + treat_`pm'`num' + L4treat_`pm'`num'  + L8treat_`pm'`num'  + L12t
> reat_`pm'`num'  + L16treat_`pm'`num'  

> timated values for the true window
.                                 
.                                 local wmax = `truewmax'
 46.                                 local wmin = `truewmin'
 47. 
.                                 global PA_p0 "[treat_p0  ]*(4)*(1/${E})"     
>            // Multiplying by 4 to get $ bin estimates. Dividing by E to get s
> hare of workforce.
 48.                                 global PA_p0 "`denominator'*(${PA_p0})"
 49. 
.                                 forval j = 1/`wmax' {
 50.                                         global PA_p`j' "[treat_p`j' ]*(4)*
> (1/${E})"
 51.                                         global PA_p`j' "`denominator'*(${P
> A_p`j'})" 
 52.                                 }
 53.                                 
.                                 forval j = 1/`wmin' {                        
>    
 54.                                         global PA_m`j' "[treat_m`j' ]*(4)*
> (1/${E})"
 55.                                         global PA_m`j' "`denominator'*(${P
> A_m`j'})"
 56.                                 }
 57. 
.                                 
.                                 global cumul "0"
 58.                                 forval k = -`wmin'/`wmax' {     
 59.                                          di `k'
 60.                                         if `k' < 0 {
 61.                                                 local j = -`k'
 62.                                                 local lincomline "${PA_m`j
> '}"
 63.                                         }
 64.                                         else if `k'==0 {
 65.                                                 local lincomline "${PA_p0}
> "
 66.                                         }
 67.                                         else if `k'>0 {
 68.                                                 local lincomline "${PA_p`k
> '}"
 69.                                         }
 70.                                         
.                                         qui lincom   "`lincomline'"
 71.                                         local basic_b = r(estimate)
 72.                                         local basic_se = r(se)
 73.                                         if `k' == -`wmin' {
 74.                                                 mat countmat = [ `k', `bas
> ic_b',  `basic_b'-1.96*`basic_se', `basic_b'+1.96*`basic_se' ]
 75.                                         }
 76.                                         else {
 77.                                                 mat countmat = [countmat \
>  [ `k', `basic_b',  `basic_b'-1.96*`basic_se', `basic_b'+1.96*`basic_se'  ]]
 78.                                         }
 79.                                 }

. foreach regsample in fifth_ sixth_ {
  2. foreach b in   1979  {
  3.         foreach w in 1   {
  4.                 
.                 sum epop if  year>=`b' & cleansample==1  ${weight`w'}
  5.                 local denominator = r(mean)
  6.                 foreach s in      1  {
  7.                 use `temptemp', clear
  8.                         forval k=1(1)30{
  9. 
.                          reghdfe `regsample'percap`k' $treat  if  year>=`b' &
>  cleansample==1  ${weight`w'} , absorb(${a`s'}) cluster(statenum)
 10.                                 
.                                 local dof = e(df_r)
 11.                                 
.                                 foreach q in 12 /*F1*/ {
 12.                                 lincom (${lincom`q'})/`denominator'
 13.                                 local lowb      = r(estimate) - invttail(`
> dof', 0.025)*r(se) 
 14.                                 local highb     = r(estimate) + invttail(`
> dof', 0.025)*r(se) 
 15.                                 
.                                 
.                                 if `k' == 1 {
 16.                                                         mat countmat`q' = 
> [`k', r(estimate), `lowb' , `highb']
 17.                                 } // end of if
 18.                                 else {
 19.                                         mat countmat`q' = [countmat`q' \ [
> `k', r(estimate), `lowb' , `highb' ]]
 20.                                 } // end of else
 21.                         } // end of q 
 22.                         } // end of k
 23.                         foreach q in 12 /*F1*/ {
 24.                                 forval j = 31/34 {   // 32 to 31: couner c
> hanged here; but 34 kept same
 25.                                         mat countmat`q' = [countmat`q' \ [
> `j', .,.,.] ]
 26.                                 } // end of j
 27.                         } // end of q
 28. 
.                         qui reghdfe `regsample'epop $treat  if  year>=`b' & c
> leansample==1 ${weight`w'} , absorb(${a`s'}) cluster(statenum)
 29.                         local dof = e(df_r)
 30. 
.                         foreach q in 12 /*F1*/ {        
 31.                                 qui     lincom (${lincom`q'})/`denominator
> '
 32.                                 scalar ba_`w' = r(estimate)
 33.                                 scalar sea_`w'= r(se)
 34.                                 scalar ta_`w'= r(estimate)/r(se)          
>                       
 35.                                 scalar pa_`w' = ttail(r(df), r(estimate)/r
> (se))
 36.                                 local lowb      = r(estimate) - invttail(`
> dof', 0.025)*r(se) 
 37.                                 local highb     = r(estimate) + invttail(`
> dof', 0.025)*r(se) 
 38.                                 mat countmat`q' = [countmat`q' \ [35, r(es
> timate), `lowb' , `highb' ]]
 39.                                 svmat countmat`q'
 40.                                 cap drop wagebin est low high totest
 41.                                 rename countmat`q'1 wagebin
 42.                                 rename countmat`q'2 est
 43.                                 rename countmat`q'3 low
 44.                                 rename countmat`q'4 high
 45. 
.                                 g totest = est if _n==1
 46.                                 replace totest = totest[_n-1] + est if _n>
> 1
 47.                                 
.                                 local ba: di %04.3f `=ba_`w''
 48.                                 local se: di %04.3f `=sea_`w''
 49. 
.                                 local titlesixth_       "FigureG2_a"         
>    

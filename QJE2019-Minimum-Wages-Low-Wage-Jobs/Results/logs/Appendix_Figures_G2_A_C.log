>       
 51.                                 
.                                 
.                                 twoway ( bar est wagebin if wagebin<32, fcolo
> r(ltblue) ) ( bar est wagebin if wagebin==35, fcolor(purple) lcolor(purple) )
>  ///
>                                 (rcap low  high wagebin if wagebin<32, lcolor
> (green) lwidth(thick) ) (line totest wagebin, lpat(dot) lwidth(thick) lcolor(
> purple)) , ///

 13.         }       
 14.         
.         
.         if `k' == 0 {
 15.                 local K  ""
 16.         }       
 17.         
.         if `k' > 0 {
 18.                 local K  "L`k'"
 19.         }       
 20.         
.         
.         foreach j of numlist `wmin'(1)`wmax'       {
 21.                 global placeboafter1 = "$placeboafter1 `K'treat_p`j'"
 22.                 global placebocontafter1 = "$placebocontafter1  i.one#c.`K
> 'treat_p`j'"
 23.                 }
 24.         }
 25. * 
.  
. global placebobefore1 " " 
 26. 
. 
. forval k = -`tmin'(4)-8   {
 27. if `k'!=-4{
 28.         if `k' < 0 {
 29.                 local nk = -`k'
 30.                 local K  "F`nk'"
 31.         }       
 32.         
.         
.         if `k' == 0 {
 33.                 local K  ""
 34.         }       
 35.         
.         if `k' > 0 {
 36.                 local K  "L`k'"
 37.         }       
 38.         
.         
.         foreach j of numlist `wmin'(1)`wmax'  {
 39.                 global placebobefore1 = "$placebobefore1 i.one#c.`K'treat_
> p`j'"
 40.         }
 41.         }
 42.         
. }
 43. *
. 
. 
. 
. global windowpl1 " "
 44.         
.         foreach j of numlist  `wmin'(1)`wmax' {
 45.                 global windowpl1 = "$windowpl1 i.one#c.windowpl1_p`j' "
 46.         }
 47. 
. 
. *
. 
. 
. 
. 
. end


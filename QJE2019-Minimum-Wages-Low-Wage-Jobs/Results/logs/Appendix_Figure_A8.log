. capture program drop nlcomestadd

. program define nlcomestadd
  1. syntax anything, statname(name) dof(real)
  2. 
. nlcom `anything' 
  3. mat temp1 = r(b)
  4. scalar temp1 = temp1[1,1]
  5. mat temp2 = r(V)
  6. scalar temp2 = sqrt(temp2[1,1])
  7. local pvalue = 2*ttail(`dof', abs((temp1)/temp2))
  8. assert `pvalue' ~= .
  9. local b : di  %04.3f `=temp1'
 10. local se : di %04.3f `=temp2'
 11. scalar drop temp1 temp2
 12. 
. local stars ""
 13. if `pvalue' < 0.10 local stars *
 14. if `pvalue' < 0.05 local stars **
 15. if `pvalue' < 0.01 local stars ***
 16. local bstring `b'`stars'
 17. local sestring (`se')
 18. 
. estadd local `statname'b "`bstring'"
 19. estadd local `statname'se "`sestring'"
 20. 
. end

. 
. 
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. 
. capture program drop lincomestadd

. program define lincomestadd
  1. syntax anything, statname(name)
  2. 
. lincom `anything'
  3. local pvalue = 2*ttail(r(df), abs(r(estimate)/r(se)))
  4. assert `pvalue' ~= .
  5. 
. local b : di  %04.3f `r(estimate)'
  6. local se : di %04.3f `r(se)'
  7. 
. local stars ""
  8. if `pvalue' < 0.10 local stars *
  9. if `pvalue' < 0.05 local stars **
 10. if `pvalue' < 0.01 local stars ***
 11. local bstring `b'`stars'
 12. local sestring (`se')
 13. 
. estadd local `statname'b "`bstring'"
 14. estadd local `statname'se "`sestring'"
 15. 
. end


. cap program drop correctaggcont

. program define correctaggcont
  1. syntax , [TMIn(real 12) TMAx(real 16) WMAx(real 4) WMIn(real 4)]
  2. 
. 
. if `tmin'!=12 | `tmax'!=16 | `wmax'!=4 | `wmin'!=4{
  3. *
. cap drop _contf_p
  4. cap drop postcontf_p
  5. cap drop postcontf_m
  6. cap drop tempcontf_p
  7. cap drop tempcontf_m
  8. g _contf_p = 0
  9. replace _contf_p = 1 if (fedincrease==1 &  overallcountgroup>0 & $ifclause
>  ) &  (wageM25>=(MW_realM25 - 0) &  wageM25 < (MW_realM25 +1 + `wmax' - 0))
 10. g tempcontf_p = _contf_p + L._contf_p + L2._contf_p + L3._contf_p
 11. 
. local Tmax3 = `tmax' + 3
 12. forval i = 0(1)`Tmax3'{
 13.         if `i' == 0{
 14.         g postcontf_p = _contf_p
 15. 
.         }
 16.         else {
 17.         replace postcontf_p = postcontf_p + L`i'._contf_p
 18.         sum postcontf_p, meanonly
 19.         assert r(mean)!=0
 20.         }
 21. }
 22. cap drop _contf_p
 23. 
. cap drop _contf_m
 24. g _contf_m = 0
 25. replace _contf_m = 1 if (fedincrease==1 &  overallcountgroup>0 & $ifclause
>  ) &  (wageM25<(MW_realM25 - 0)  &  wageM25 >= (MW_realM25 -  `wmin' - 0 ))  
>  
 26. g tempcontf_m = _contf_m + L._contf_m + L2._contf_m + L3._contf_m
 27. forval i = 0(1)`Tmax3'{
 28.         if `i' == 0{
 29.         g postcontf_m = _contf_m
 30.         }
 31.         else {
 32.         replace postcontf_m = postcontf_m + L`i'._contf_m
 33.         sum postcontf_m, meanonly
 34.         assert r(mean)!=0
 35. 
.         }
 36. }
 37. cap drop _contf_m
 38. 
. 
. 
. *Leads
. cap drop precontf_*
 39. cap drop earlycontf_*
 40. if `tmin' == 12{
 41.         foreach k in m p {
 42.                 g precontf_`k' = F4.tempcontf_`k'
 43.                 replace precontf_`k' = 0 if precontf_`k' == .
 44.                 
.         }
 45. *
. 
. foreach k in m p {
 46.                 g earlycontf_`k' = F12.tempcontf_`k' + F8.tempcontf_`k'
 47.                 replace earlycontf_`k' = 0 if earlycontf_`k' == .
 48.                 
.         }
 49. }
 50. if `tmin'==8{
 51.         foreach k in m p {
 52.                 g precontf_`k' = F4.tempcontf_`k'
 53.                 replace precontf_`k' = 0 if precontf_`k' == .
 54. 
.         }
 55. *
. 
. foreach k in m p {
 56.                 g earlycontf_`k' = F8.tempcontf_`k'
 57.                 replace earlycontf_`k' = 0 if earlycontf_`k' == .
 58.                 
.         }
 59. 
. 
. 
. }
 60. *
. 
. *************   Other    
. 
. cap drop tempcont_*
 61. cap drop postcont_*
 62. cap drop _cont_p
 63. g _cont_p = 0
 64. replace _cont_p = 1 if ($missedevents | toosmall==1) &  (wageM25>=(MW_real
> M25 - 0) &  wageM25 < (MW_realM25 +1 + `wmax' - 0))
 65. g tempcont_p = _cont_p + L._cont_p + L2._cont_p + L3._cont_p
 66. 
. local Tmax3 = `tmax' + 3
 67. forval i = 0(1)`Tmax3'{
 68.         if `i' == 0{
 69.         g postcont_p = _cont_p
 70.         }
 71.         else {
 72.         replace postcont_p = postcont_p + L`i'._cont_p
 73.         }
 74. }
 75. cap drop _cont_p
 76. 
. cap drop _cont_m
 77. g _cont_m = 0
 78. replace _cont_m = 1 if ($missedevents | toosmall==1) &  (wageM25<(MW_realM
> 25 - 0)  &  wageM25 >= (MW_realM25 -  `wmin' - 0 ))   
 79. g tempcont_m = _cont_m + L._cont_m + L2._cont_m + L3._cont_m
 80. forval i = 0(1)`Tmax3'{
 81.         if `i' == 0{
 82.         g postcont_m = _cont_m
 83.         }
 84.         else {
 85.         replace postcont_m = postcont_m + L`i'._cont_m
 86.         }
 87. }
 88. cap drop _cont_m
 89. 
. cap drop precont_*
 90. cap drop earlycont_*
 91. if `tmin'==12{
 92.         foreach k in m p {
 93.                 g precont_`k' = F4.tempcont_`k'
 94.                 replace precont_`k' =  0 if precont_`k' == .
 95.                 
.         }
 96. *
. 
. foreach k in m p {
 97.                 g earlycont_`k' = F12.tempcont_`k' + F8.tempcont_`k'
 98.                 replace earlycont_`k' = 0 if earlycont_`k' == .
 99.                 
.         }
100. }
101. if `tmin'==8{
102.         foreach k in m p {
103.                 g precont_`k' = F4.tempcont_`k'
104.                 replace precont_`k' =  0 if precont_`k' == .            
105.                 
.         }
106. *
. 
. foreach k in m p {
107.                 g earlycont_`k' =  F8.tempcont_`k'
108.                 replace earlycont_`k' = 0 if earlycont_`k' == .
109.                 
.         }
110. 
. }
111. 
. replace postcont_p = 0 if postcont_p==.
112. replace postcont_m = 0 if postcont_m==.
113. 
. replace postcontf_p = 0 if postcontf_p==.
114. replace postcontf_m = 0 if postcontf_m==.
115. 
. }
116. 
. else{
117. di "No need to correct anything. You are using the default settings."
118. }
119. end


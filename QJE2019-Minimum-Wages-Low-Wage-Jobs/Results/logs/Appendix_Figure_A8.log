. cap program drop makefigure_massbywagebin

. program define makefigure_massbywagebin
  1. syntax , [Tmin(real 12) Tmax(real 16)  Wmax(real 4) Wmin(real 4)]
  2. 
.                                 local denominator = (1/(1+(`tmax'/4)))
  3. 
. 
.                                 global PA_p0 "[treat_p0  ]*(4)*(1/${E})"     
>            // Multiplying by 4 to get $ bin estimates. Dividing by E to get s
> hare of workforce.
  4.                                 forval t = 4(4)`tmax' {
  5.                                         global PA_p0  "${PA_p0} + [ L`t'tr
> eat_p0 ]*(4)*(1/${E})"
  6.                                 }
  7.                                 global PA_p0 "`denominator'*(${PA_p0})"
  8. 
.                                 forval j = 1/`wmax' {
  9.                                         global PA_p`j' "[treat_p`j' ]*(4)*
> (1/${E})"
 10.                                 forval t = 4(4)`tmax' {
 11.                                                         global PA_p`j'    
> " ${PA_p`j'} + [L`t'treat_p`j' ]*(4)*(1/${E})"
 12.                                                 }
 13.                                         global PA_p`j' "`denominator'*(${P
> A_p`j'})" 
 14.                                 }
 15.                                 
.                                 forval j = 1/`wmin' {                        
>    
 16.                                         global PA_m`j' "[treat_m`j' ]*(4)*
> (1/${E})"
 17.                                 forval t = 4(4)`tmax' {
 18.                                                         global PA_m`j'    
> " ${PA_m`j'} + [L`t'treat_m`j' ]*(4)*(1/${E})"
 19.                                                 }
 20.                                         global PA_m`j' "`denominator'*(${P
> A_m`j'})"
 21.                                 }
 22. 
.                                 
.                                 global cumul "0"
 23.                                 forval k = -`wmin'/`wmax' {     
 24.                                          di `k'
 25.                                         if `k' < 0 {
 26.                                                 local j = -`k'
 27.                                                 local lincomline "${PA_m`j
> '}"
 28.                                         }
 29.                                         else if `k'==0 {
 30.                                                 local lincomline "${PA_p0}
> "
 31.                                         }
 32.                                         else if `k'>0 {
 33.                                                 local lincomline "${PA_p`k
> '}"
 34.                                         }
 35.                                         
.                                         qui lincom   "`lincomline'"
 36.                                         local basic_b = r(estimate)
 37.                                         local basic_se = r(se)
 38.                                         global cumul "${cumul} + `lincomli
> ne'"
 39.                                         qui lincom "${cumul}"
 40.                                         local cumul_b = r(estimate)
 41.                                         local cumul_se = r(se)
 42.                                         if `k' == -`wmin' {
 43.                                                 mat countmat = [ `k', `bas
> ic_b',  `basic_b'-1.96*`basic_se', `basic_b'+1.96*`basic_se', `cumul_b', `cum
> ul_b'-1.96*`cumul_se', `cumul_b'+1.96*`cumul_se' ]
 44.                                         }
 45.                                         else {
 46.                                                 mat countmat = [countmat \
>  [ `k', `basic_b',  `basic_b'-1.96*`basic_se', `basic_b'+1.96*`basic_se', `cu
> mul_b', `cumul_b'-1.96*`cumul_se', `cumul_b'+1.96*`cumul_se' ]]
 47.                                         }
 48.                                 }
 49.                                 
.                 /*                                                           
>                    
>                         nlcom "-(${above_full})/(${below_full})"
>                         mat b = r(b)
>                         mat V = r(V)
>  
>                         local bunchestb: di %3.2f  b[1,1]
>                         local bunchestse: di %3.2f sqrt(V[1,1])
>                         global bunchest "Bunching estimate=`bunchestb'(`bunch
> estse')"
>                         
>                 */      
.                          
.                         cap drop bin* 
 50.                         cap drop est* 
 51.                         cap drop low *
 52.                         cap drop high* 
 53.                         cap drop _est*
 54.                         cap drop totest*
 55.                         cap drop totlow
 56.                         cap drop tothigh
 57.                         cap drop countmat*
 58.                         
.                         svmat countmat
 59.                         rename countmat1 bin
 60.                         rename countmat2 est                    
 61.                         rename countmat3 low
 62.                         rename countmat4 high
 63.                         rename countmat5 totest                 
 64.                         rename countmat6 totlow
 65.                         rename countmat7 tothigh                        
 66.                         
.                         qui sum totest if bin==`wmax' 
 67.                         local elastb: di %3.2f  r(mean)
 68.                         qui sum tothi if bin==`wmax' 
 69.                         local elasthi: di %3.2f  r(mean)
 70.                         qui sum totlow if bin==`wmax' 
 71.                         local elastlow: di %3.2f  r(mean)
 72. 
.                         global elastest "MW elasticty=`elastb', CI=[`elastlow
> ', `elasthi']"
 73.                         
.                          
.                                 twoway ( bar est bin  , fcolor(ltblue) lcolor
> (none) ) ///
>                                 (rcap low  high bin  , lcolor(ltblue*1.25) lw
> idth(thick) ) ///
>                                 (line totest bin, lcolor(red*.33) lpat(line) 
> lwidth(thick) ) /* ///
>                                 (line totlow  bin , color(red) lpat(dot)) ///
>                                 (line tothigh  bin , color(red) lpat(dot))   
>    */                      , ///
>                                 /* xlabel(-4 "[-`=char(36)'4.25, -`=char(36)'
> 3.25)" -2 "[-`=char(36)'2.25, -`=char(36)'1.25)" 0 "[-`=char(36)'0.25, `=char
> (36)'0.75)" ///
>                                  2 "[`=char(36)'1.75, `=char(36)'2.75)" 4 "[`
> =char(36)'3.75, `=char(36)'4.75)" , labsize(medsmall) ) ///
>                                  ylabel( -0.004  -0.002   0  0.002 0.004 0.00
> 6) */ ///
>                                  xlabel(-4 "-4" -3 "-3" -2 "-2" -1 "-1" 0 "0"
>  1 "1" 2 "2" 3 "3" 4 "4"  ///
>                                 , labsize(medsmall) ) ///
>                                 ylabel(, labsize(medsmall)) scheme(s1color) /
> *xtitle("Wage Bin")*/ xtitle("Wage bins in `=char(36)' relative to new MW", s
> ize(medsmall)) xsc(titlegap(*10)) ytitle("", height(10))   ///
>                                 /*title("${label`s'}", size(medium) )*/ legen
> d(off) /*  ///
>                                 note("${bunchest}" , size(small) color(blue))
>  */
 74.  
. 
. 
. end

. 

.          g treat_p`k' = ( _treat_p`k' +  L._treat_p`k' + L2._treat_p`k' + L3.
> _treat_p`k')
 35.         cap drop _treat_p`k'
 36. 
. }
 37. 
. forval k = 1/5  {

. cap program drop placebowindows1

. program define placebowindows1
  1. syntax  , Wmax(real) TRUEwmax(real) [Tmax(real 16) Tmin(real 12)]  
  2. 
. 
.                         *****************************************************
> ***************
.                         ***************         Placebo Treatment Vector     
>       *********
.                         *****************************************************
> ***************
. 
. global placeboafter1 " "
  3. global placebobefore1 " "
  4. global placebocontafter1 " "
  5. 
.  local wmin = `truewmax'  + 1
  6. di "Placebo wmin and wmax should not be too far apart." 
  7. di "`wmax' - `wmin'"
  8. assert `wmax' - `wmin' < 9
  9.  
. forval k = 0(4)`tmax'   {
 10.         if `k' < 0 {
 11.                 local nk = -`k'

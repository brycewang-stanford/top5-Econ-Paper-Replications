.  local wmin = `truewmax'  + 1
  6. di "Placebo wmin and wmax should not be too far apart." 
  7. di "`wmax' - `wmin'"
  8. assert `wmax' - `wmin' < 9
  9.  
. forval k = 0(4)`tmax'   {
 10.         if `k' < 0 {
 11.                 local nk = -`k'
 12.                 local K  "F`nk'"
 13.         }       
 14.         
.         
.         if `k' == 0 {
 15.                 local K  ""
 16.         }       
 17.         

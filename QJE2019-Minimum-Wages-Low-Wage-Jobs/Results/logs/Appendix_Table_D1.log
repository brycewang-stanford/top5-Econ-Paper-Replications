  4. local emploss = r(estimate)
  5. 
. 
. 
.                         foreach t of numlist 0(4)`tmax' {
  6. 
.                         if `t'==0{
  7.                                 foreach nn2 of numlist 0(1)4{
  8.                                 
.                                 if "`secondmethod'" != "Y" {
  9.                                 global coefficient`nn2'  "-((_b[treat_p`nn
> 2'])/(_b[treat_p0] + _b[treat_p1] + _b[treat_p2] + _b[treat_p3] + _b[treat_p4
> ]))*(1+`emploss')"
 10.                                 if `nn2'==0{                            
 11.                                 global coefficient`nn2'  " (${coefficient`
> nn2'}) +  (`emploss')"
 12.                                 }
 13.                                 }               
 14.                                 
.                                 if "`secondmethod'" == "Y"{
 15.                                 if `nn2'==0{
 16.                                 global coefficient`nn2'  "-1"
 17.                                 }
 18.                                 else{
 19.                                 global coefficient`nn2'  "0"              
>               
 20.                                 }
 21.                                 }
 22.                                 global aboveWBL`t'_`nn2'`secondmethod' "0"
 23.                                 foreach nn of numlist 1(1)4{
 24.                                                 local nn3 = `nn'+`nn2'
 25.                                                 global aboveWBL`t'_`nn2'`s
> econdmethod' "  ${aboveWBL`t'_`nn2'`secondmethod'} + (`nn3'*_b[treat_m`nn'])"
 26.                                         }
 27.                                         global aboveWBL`t'_`nn2'`secondmet
> hod' " ( ${aboveWBL`t'_`nn2'`secondmethod'})* (${coefficient`nn2'})"
 28.                                 }
 29. 
. 
.                         }
 30.                         
.                         if `t'>0{
 31.                                 global aboveWBL`t'`secondmethod' " 0 "
 32.                                 foreach nn2 of numlist 0(1)4{
 33.                                 
.                                 if "`secondmethod'" != "Y" {
 34.                                 global coefficient`nn2'  "-((_b[L`t'treat_
> p`nn2'])/(_b[L`t'treat_p0] + _b[L`t'treat_p1] + _b[L`t'treat_p2] + _b[L`t'tre
> at_p3] + _b[L`t'treat_p4]))*(1+`emploss')"
 35.                                 if `nn2'==0{                            
 36.                                 global coefficient`nn2'  " (${coefficient`
> nn2'}) +  (`emploss')"
 37.                                 }
 38.                                 }                       
 39.                                 
.                                 if "`secondmethod'" == "Y"{
 40.                                 if `nn2'==0{
 41.                                 global coefficient`nn2'  "-1"
 42.                                 }
 43.                                 else{
 44.                                 global coefficient`nn2'  "0"              
>               
 45.                                 }
 46.                                 }
 47.                                 global aboveWBL`t'_`nn2'`secondmethod' "0"
 48.                                         foreach nn of numlist 1(1)4{
 49.                                                 local nn3 = `nn'+`nn2'
 50.                                                 global aboveWBL`t'_`nn2'`s
> econdmethod' "  ${aboveWBL`t'_`nn2'`secondmethod'} + (`nn3'*_b[L`t'treat_m`nn
> '])"
 51.                                         }
 52.                                         global aboveWBL`t'_`nn2'`secondmet
> hod' " ( ${aboveWBL`t'_`nn2'`secondmethod'})* (${coefficient`nn2'})"
 53. 
.                                 }
 54.                         
.                         }
 55.                         }
 56.                         
.                         
.                         global aboveWBF4 = 0
 57.                         global belowWBF4 = 0
 58.                         
.                         
. *
. end


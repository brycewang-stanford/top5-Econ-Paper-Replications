> `t'treat`y'_p0])*(${wagemult`y'}+0))"
 26.                                                 forval j = 1/`wmax' {
 27.                                                         global aboveWBL`t'
> `y' "${aboveWBL`t'`y'} + ((_b[L`t'treat`y'_p`j'])*(${wagemult`y'}+`j'))"
 28.                                                 }
 29.                                                 global belowWBL`t'`y' "((_
> b[L`t'treat`y'_m1])*(${wagemult`y'}-1) )"
 30.                                                 forval j = 2/`wmin' {
 31.                                                         global belowWBL`t'
> `y' "${belowWBL`t'`y'} + ((_b[L`t'treat`y'_m`j'])*(${wagemult`y'}-`j'))"
 32.                                                 }
 33. 
.                                         }
 34.         
.  
.                         } 
 35.                         global aboveWBF4`y' = 0
 36.                         global belowWBF4`y' = 0
 37. 
.                         

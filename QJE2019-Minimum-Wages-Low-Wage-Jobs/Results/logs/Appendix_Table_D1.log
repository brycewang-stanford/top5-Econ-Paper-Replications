> K'treat_m`j'"
 55.         }
 56.         }
 57. }
 58. *
. foreach vv in 0 250{
 59. forval k = 0(4)`tmax'   {
 60.         if `k' < 0 {
 61.                 local nk = -`k'
 62.                 local K  "F`nk'"
 63.         }       

  6.                                                         local nt = -`t' 
  7.                                                         global aboveWBF`nt
> ' "((_b[F`nt'treat_p0])*(`wagemult'+0) )"
  8.                                                 forval j = `wincrement'(`w
> increment')`wmaxcent2' {
  9.                                                 local k = `j'/100

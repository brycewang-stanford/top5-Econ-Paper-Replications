> `y' "${aboveWBL`t'`y'} + ((_b[treat`y'_p`j'])*(${wagemult`y'}+`j') )"
 18.                                                 }
 19.                                                 global belowWBL`t'`y' "((_
> b[treat`y'_m1])*(${wagemult`y'}-1) )"
 20.                                                 forval j = 2/`wmin' {
 21.                                                         global belowWBL`t'
> `y' "${belowWBL`t'`y'} + ((_b[treat`y'_m`j'])*(${wagemult`y'}-`j') )"
 22.                                                 }
 23. 
.                                         }
 24.         
.                                         if `t' > 0 {    
 25.                  

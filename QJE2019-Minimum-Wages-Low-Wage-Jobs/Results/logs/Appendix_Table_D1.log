> K'treat_p`j'"
 73.         }
 74.         }
 75. }
 76. * 
. global controlbefore " "
 77. forval k = -`tmin'(4)-8   {
 78. if `k'!=-4{
 79.         if `k' < 0 {
 80.                 local nk = -`k'
 81.                 local K  "F`nk'"
 82.         }       
 83.         
.         
.         if `k' == 0 {

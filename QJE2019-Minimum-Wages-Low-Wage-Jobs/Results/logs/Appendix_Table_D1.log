  7.                                         local ase = sqrt(V[1,1])*(4)*(1/${
> E})
  8.                                         nlcom ("${belowL`t'}") 
  9.                                         mat b = r(b)
 10.                                         mat V = r(V)
 11.                                         local bb =  (b[1,1]*(4))*(1/${E})
 12.                                         local bse = sqrt(V[1,1])*(4)*(1/${
> E})
 13.                                         mat eventmat = [eventmat \ [`t', `
> ab', `ab'-1.96*`ase', `ab'+1.96*`ase',  `bb', `bb'-1.96*`bse', `bb'+1.96*`bse
> '] ]

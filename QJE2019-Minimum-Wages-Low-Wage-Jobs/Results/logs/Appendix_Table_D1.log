. cap program drop finerabovebelowbunch

. program define finerabovebelowbunch
  1. syntax [,Tmin(real 12) Tmax(real 16) WMAXcent(real 500) WMINcent(real 400)
>  WINCrement(real 25) ]
  2. 
. local wmaxcent2 = `wmaxcent' - `wincrement'
  3. local wincrement2 = `wincrement' * 2
  4. 
. foreach t of numlist -`tmin'(4)`tmax' {
  5. 
.         if `t' < -4  {  
  6.                 local nt = -`t' 
  7.                 global aboveF`nt' "(_b[F`nt'treat_p0] )"
  8.                 forval j = `wincrement'(`wincrement')`wmaxcent2' {
  9.                         global aboveF`nt' "${aboveF`nt'} + (_b[F`nt'treat_
> p`j'] )"
 10.                 }
 11.                 global belowF`nt' "(_b[F`nt'treat_m`wincrement'] )"
 12.                 forval j = `wincrement2'(`wincrement')`wmincent' {
 13.                         global belowF`nt' "${belowF`nt'} + (_b[F`nt'treat_
> m`j'] )"
 14.                 }
 15. 
.     }
 16.  
.         if `t' == -4 {
 17.                 global aboveF4 "0"
 18.                 global belowF4 "0"
 19.         }
 20.  
.         if `t' == 0 {   
 21.                  
.                 global aboveL`t' "(_b[treat_p0])"
 22.                 forval j = `wincrement'(`wincrement')`wmaxcent2'  {
 23.                         global aboveL`t' "${aboveL`t'} + (_b[treat_p`j'] )
> "
 24.                 }
 25.                 global belowL`t' "(_b[treat_m`wincrement'] )"
 26.                 forval j = `wincrement2'(`wincrement')`wmincent'  {
 27.                         global belowL`t' "${belowL`t'} + (_b[treat_m`j'] )
> "
 28.                 }
 29. 
.     }
 30.         
.    if `t' > 0 { 
 31.                  
.                 global aboveL`t' "(_b[L`t'treat_p0])"
 32.                 forval j = `wincrement'(`wincrement')`wmaxcent2'  {
 33.                         global aboveL`t' "${aboveL`t'} + (_b[L`t'treat_p`j
> '])"
 34.                 }
 35.                 global belowL`t' "(_b[L`t'treat_m`wincrement'])"
 36.                 forval j = `wincrement2'(`wincrement')`wmincent' {
 37.                         global belowL`t' "${belowL`t'} + (_b[L`t'treat_m`j
> '])"
 38.                 }
 39. 
.     }

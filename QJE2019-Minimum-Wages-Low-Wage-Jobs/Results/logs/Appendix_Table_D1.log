 16.                 
.                 g byte F`j'treat_p`k' = F`j'.treat_p`k'
 17.                 g byte L`j'treat_p`k' = L`j'.treat_p`k'
 18.                 
.                 replace F`j'treat_p`k' = 0 if  F`j'treat_p`k'==. 
 19.                 replace L`j'treat_p`k' = 0 if  L`j'treat_p`k'==.          
>       
 20. 
.         }
 21. } 

> pm'`num' +  F4treat_`pm'`num' + treat_`pm'`num' + L4treat_`pm'`num'  + L8trea
> t_`pm'`num'  + L12treat_`pm'`num'  + L16treat_`pm'`num'  
 25.         }
 26. }
 27. *

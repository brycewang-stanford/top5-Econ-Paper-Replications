 20. 
. 
. 
. lowess  w_count_sh wagebins_relMW if wagebins_relMW<0  & wagebins_relMW>=-`wm
> incent'  , nograph gen(w_1) 
 21. lowess  w_count_sh wagebins_relMW if wagebins_relMW>0  & wagebins_relMW< `
> wmaxcent'   , nograph gen(w_2)

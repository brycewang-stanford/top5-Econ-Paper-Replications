 65.         
.         if `k' == 0 {
 66.                 local K  ""
 67.         }       
 68.         
.         if `k' > 0 {
 69.                 local K  "L`k'"
 70.         }       
 71.         
.         
.         foreach j of numlist `vv'(`wincrement')`temp'       {

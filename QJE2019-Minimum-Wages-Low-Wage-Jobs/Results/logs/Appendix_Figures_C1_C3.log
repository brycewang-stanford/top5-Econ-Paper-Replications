> 02+ treat_p`num'_2003+ treat_p`num'_2004)/5"
  4. }

. *
. local counter = 0

. forval num2 = 1(1)`loww'{
  2. qui lincom ${CSBW_m`num2'}
  3. local counter= `counter' + 1
  4. if `counter' == 1{
  5. mat estimates = ( r(estimate), -`num2' )
  6. }
  7. else{
  8. mat estimates = ( estimates  \ r(estimate), -`num2' )
  9. }
 10. }


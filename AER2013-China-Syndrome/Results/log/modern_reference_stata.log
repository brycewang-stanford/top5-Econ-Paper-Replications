  log type:  text
 opened on:  16 Sep 2026, 23:14:13

. 
. use "$ROOT/Data/dta/workfile_china.dta", clear

. local full l_shind_manuf_cbp l_sh_popedu_c l_sh_popfborn l_sh_empl_f l_sh_rou
> tine33 l_task_outsource reg_midatl reg_encen reg_wncen reg_satl reg_escen reg
> _wscen reg_mount reg_pacif t2

. 
. tempname fh

. file open `fh' using "$ROOT/Results/log/modern_reference_stata.csv", write re
> place text

. file write `fh' "spec,stat,value" _n

. 
. foreach spec in c1 c6 c6u {
  2.     if "`spec'" == "c1" local ctrl t2
  3.     else local ctrl `full'
  4.     local wgt "[aw=timepwt48]"
  5.     if "`spec'" == "c6u" local wgt ""   // unweighted variant: isolates we
> ight handling across software
  6. 
.     * --- ivreg2: same point estimate as ivregress; KP F; AR test -----------
> ----
.     ivreg2 d_sh_empl_mfg (d_tradeusch_pw = d_tradeotch_pw_lag) `ctrl' `wgt', 
> cluster(statefip)
  7.     file write `fh' "`spec',b," %20.12g (_b[d_tradeusch_pw]) _n
  8.     file write `fh' "`spec',se_ivreg2," %20.12g (_se[d_tradeusch_pw]) _n
  9.     file write `fh' "`spec',kp_rk_wald_F," %20.12g (e(widstat)) _n
 10.     file write `fh' "`spec',ar_F," %20.12g (e(arf)) _n
 11.     file write `fh' "`spec',ar_p," %20.12g (e(arfp)) _n
 12. 
.     * --- Olea-Pflueger effective F -----------------------------------------
> -
.     cap noisily weakivtest
 13.     if !_rc {
 14.         return list
 15.         file write `fh' "`spec',F_eff," %20.12g (r(F_eff)) _n
 16.         cap file write `fh' "`spec',F_eff_crit_tau10_5pct," %20.12g (r(c_T
> SLS_10)) _n
 17.     }
 18. 
.     * --- weak-IV robust confidence sets ------------------------------------
> ---
.     cap noisily weakiv ivreg2 d_sh_empl_mfg (d_tradeusch_pw = d_tradeotch_pw_
> lag) `ctrl' `wgt', cluster(statefip) usegrid gridpoints(2001) gridmin(-2) gri
> dmax(1)
 19.     if !_rc {
 20.         ereturn list
 21.         cap file write `fh' "`spec',ar_cset,`e(ar_cset)'" _n
 22.         cap file write `fh' "`spec',clr_cset,`e(clr_cset)'" _n
 23.         cap file write `fh' "`spec',k_cset,`e(k_cset)'" _n
 24.         cap file write `fh' "`spec',wald_cset,`e(wald_cset)'" _n
 25.     }
 26. 
.     * --- WRE wild cluster bootstrap ----------------------------------------
> ------
.     qui ivreg2 d_sh_empl_mfg (d_tradeusch_pw = d_tradeotch_pw_lag) `ctrl' `wg
> t', cluster(statefip)
 27.     cap noisily boottest d_tradeusch_pw, reps(9999) seed(20130601) nograph
 28.     if !_rc {
 29.         return list
 30.         file write `fh' "`spec',wre_p," %20.12g (r(p)) _n
 31.         cap mat CI = r(CI)
 32.         cap file write `fh' "`spec',wre_ci_lo," %20.12g (CI[1,1]) _n
 33.         cap file write `fh' "`spec',wre_ci_hi," %20.12g (CI[1,2]) _n
 34.     }
 35. }

. do Program/statspai/export_stata_estimates.do 

. *****************************************************************************
> **
. * export_stata_estimates.do
. *   Re-runs every rdrobust cell of the author's do-files (Tables I, III-VII) 
> with
. *   the author's exact options and posts e() results to a tidy CSV, so that t
> he
. *   original-Stata numbers can be compared cell-by-cell with the paper and wi
> th
. *   StatsPAI (outreg2's .txt output drops columns and rounds to 2 decimals).
. *   Not part of the author's package. Run from the project root:
. *     stata-mp -b do Program/statspai/export_stata_estimates.do
. *****************************************************************************
> **
. clear all

. set more off

. global root "`c(pwd)'"

. global pkg  "$root/Data/Replication Materials"

. cap mkdir "$root/Results/statspai"

. 
. tempname P

. postfile `P' str8 exhibit str40 row int col str60 file str40 y str60 cond ///
>     str12 kernel str10 bwselect str8 masspts ///
>     double N h_l h_r b_l b_r tau_cl se_cl tau_bc se_rb N_h_l N_h_r ///
>     using "$root/Results/statspai/stata_estimates.dta", replace
(file
    /Users/brycewang/Documents/GitHub/top5-Econ-Paper-Replications/QJE2020-Wa
    > tering-Down-Environmental-Regulation/Results/statspai/stata_estimates.d
    > ta not found)

. 
. capture program drop onerd

. program define onerd
  1.     syntax, P(string) EX(string) ROW(string) COL(integer) FILE(string) Y(s
> tring) ///
>             COND(string) KERN(string) [BW(string) MP(string)]
  2.     use "$pkg/`file'", clear
  3.     local mpopt "masspoints(off)"
  4.     if "`mp'" == "adjust" local mpopt ""
  5.     local bwopt ""
  6.     if "`bw'" != "" local bwopt "bwselect(`bw')"
  7.     qui rdrobust `y' distance_new if `cond', `mpopt' `bwopt' kernel(`kern'
> ) all vce(cluster site_id)
  8.     local bwl = cond("`bw'" == "", "mserd", "`bw'")
  9.     local mpl = cond("`mp'" == "", "off", "`mp'")
 10.     post `p' ("`ex'") ("`row'") (`col') ("`file'") ("`y'") ("`cond'") ("`k
> ern'") ("`bwl'") ("`mpl'") ///
>         (e(N)) (e(h_l)) (e(h_r)) (e(b_l)) (e(b_r)) (e(tau_cl)) (e(se_tau_cl))
>  (e(tau_bc)) (e(se_tau_rb)) (e(N_h_l)) (e(N_h_r))
 11. end

. 
. local K3 "tri epa uni"

. 
. * ---------------- Table I ----------------
. foreach y in tfpop_s resid1_tfpop_s resid2_tfpop_s {
  2.     local c = 0
  3.     foreach g in 1 0 {
  4.         foreach k of local K3 {
  5.             local ++c
  6.             onerd, p(`P') ex(T1) row(`y') col(`c') file(T1_Baseline/tfp_sm
> all_QJE_final.dta) y(`y') cond(neg_ind0==`g') kern(`k')
  7.         }
  8.     }
  9. }

. 
. * ---------------- Table III ----------------
. foreach y in resid1_lrze resid1_lnv resid1_lnl resid1_lnk resid1_lnm resid1_l
> nv_l resid1_lnv_k {
  2.     local c = 0
  3.     foreach f in channels_QJE_final channels_Pre_QJE_final {
  4.         foreach k of local K3 {
  5.             local ++c
  6.             onerd, p(`P') ex(T3) row(`y') col(`c') file(T3_Channels/`f'.dt
> a) y(`y') cond(neg_ind0==1) kern(`k')
  7.         }
  8.     }
  9. }

. 
. * ---------------- Table IV ----------------
. foreach y in resid1_hours resid1_log_water resid1_machine resid1_total_capaci
> ty {
  2.     local c = 0
  3.     foreach k of local K3 {
  4.         local ++c
  5.         onerd, p(`P') ex(T4) row(`y') col(`c') file(T4_Abatement/abatement
> _QJE_final.dta) y(`y') cond(1) kern(`k')
  6.     }
  7. }

. 
. * ---------------- Table V ----------------
. foreach y in resid_log_cod resid_log_cod_intensity resid_log_nh resid_log_nh_
> intensity resid_log_waste_water resid_log_waste_water_intensity {
  2.     local c = 0
  3.     foreach k of local K3 {
  4.         local ++c
  5.         onerd, p(`P') ex(T5) row(`y') col(`c') file(T5_Emissions/water_emi
> ssion_QJE_final.dta) y(`y') cond(1) kern(`k')
  6.     }
  7. }

. foreach y in resid_log_so2 resid_log_nox {
  2.     local c = 0
  3.     foreach k of local K3 {
  4.         local ++c
  5.         onerd, p(`P') ex(T5) row(`y') col(`c') file(T5_Emissions/air_emiss
> ion_QJE_final.dta) y(`y') cond(1) kern(`k')
  6.     }
  7. }

. 
. * ---------------- Table VI ----------------
. local c = 0

. foreach k of local K3 {
  2.     local ++c
  3.     onerd, p(`P') ex(T6) row(fee) col(`c') file(T6_PE/pwf_QJE_final.dta) y
> (resid1_l_pwf) cond(1) kern(`k') bw(certwo)
  4. }

. foreach inc in 1 0 {
  2.     local c = 0
  3.     foreach g in 1 0 {
  4.         foreach k of local K3 {
  5.             local ++c
  6.             onerd, p(`P') ex(T6) row(party_inc`inc') col(`c') file(T6_PE/P
> E_QJE_final.dta) y(resid1_tfpop_s) cond(neg_ind0==`g' & party_inc==`inc') ker
> n(`k')
  7.         }
  8.     }
  9. }

. foreach a in 1 0 {
  2.     local c = 0
  3.     foreach g in 1 0 {
  4.         foreach k of local K3 {
  5.             local ++c
  6.             * author's code: nonpolluting x automatic x uniform uses bwsel
> ect(msecomb1) and no masspoints(off)
.             if `a' == 1 & `g' == 0 & "`k'" == "uni" {
  7.                 onerd, p(`P') ex(T6) row(automatic`a') col(`c') file(T6_PE
> /auto_QJE_final.dta) y(resid1_tfpop_s) cond(neg_ind0==`g' & automatic==`a') k
> ern(`k') bw(msecomb1) mp(adjust)
  8.             }
  9.             else {
 10.                 onerd, p(`P') ex(T6) row(automatic`a') col(`c') file(T6_PE
> /auto_QJE_final.dta) y(resid1_tfpop_s) cond(neg_ind0==`g' & automatic==`a') k
> ern(`k')
 11.             }
 12.         }
 13.     }
 14. }

. 
. * ---------------- Table VII ----------------
. foreach s in 0 1 {
  2.     local c = 0
  3.     foreach g in 1 0 {
  4.         foreach k in tri epa uniform {
  5.             local ++c
  6.             onerd, p(`P') ex(T7) row(soe`s') col(`c') file(T7_Burden/soe_v
> s_private_QJE_final.dta) y(resid1_tfpop_s) cond(neg_ind0==`g' & soe==`s') ker
> n(`k')
  7.         }
  8.     }
  9. }

. foreach s in 0 1 {
  2.     local c = 0
  3.     foreach g in 1 0 {
  4.         foreach k in tri epa uniform {
  5.             local ++c
  6.             onerd, p(`P') ex(T7) row(firm_big`s') col(`c') file(T7_Burden/
> big_vs_small_QJE_final.dta) y(resid1_tfpop_s) cond(neg_ind0==`g' & firm_big==
> `s') kern(`k')
  7.         }
  8.     }
  9. }

. * author's kernel order here is "epa tri uni" (the paper labels these columns
>  Triangle/Epanech./Uniform)
. foreach s in 1 0 {
  2.     local c = 0
  3.     foreach g in 1 0 {
  4.         foreach k in epa tri uni {
  5.             local ++c
  6.             onerd, p(`P') ex(T7) row(nsbd`s') col(`c') file(T7_Burden/NSBD
> _QJE_final.dta) y(resid1_tfpop_s) cond(neg_ind0==`g' & nsbd_c==`s') kern(`k')
  7.         }
  8.     }
  9. }

. 
. * ---------------- published-spec variants (differ from shipped do-files) ---
> -------------
. * Table V uniform column in the paper = bwselect(msecomb1); Table VI Panel A 
> cols 1-2 = mserd
. foreach y in resid_log_cod resid_log_cod_intensity resid_log_nh resid_log_nh_
> intensity resid_log_waste_water resid_log_waste_water_intensity {
  2.     onerd, p(`P') ex(T5) row(`y'@msecomb1) col(3) file(T5_Emissions/water_
> emission_QJE_final.dta) y(`y') cond(1) kern(uni) bw(msecomb1)
  3. }

. foreach y in resid_log_so2 resid_log_nox {
  2.     onerd, p(`P') ex(T5) row(`y'@msecomb1) col(3) file(T5_Emissions/air_em
> ission_QJE_final.dta) y(`y') cond(1) kern(uni) bw(msecomb1)
  3. }

. local c = 0

. foreach k of local K3 {
  2.     local ++c
  3.     onerd, p(`P') ex(T6) row(fee@mserd) col(`c') file(T6_PE/pwf_QJE_final.
> dta) y(resid1_l_pwf) cond(1) kern(`k')
  4. }

. 
. postclose `P'

. use "$root/Results/statspai/stata_estimates.dta", clear

. export delimited using "$root/Results/statspai/stata_estimates.csv", replace
file /Users/brycewang/Documents/GitHub/top5-Econ-Paper-Replications/QJE2020-Wat
> ering-Down-Environmental-Regulation/Results/statspai/stata_estimates.csv save
> d

. erase "$root/Results/statspai/stata_estimates.dta"

. di as result "exported " _N " rdrobust cells"
exported 170 rdrobust cells

. 
end of do-file

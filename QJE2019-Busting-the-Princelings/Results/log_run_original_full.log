. *****************************************************************************
> **
. * run_original.do — wrapper for Chen & Kung (2019, QJE) "Tables&Figures.do"
. *
. * The author's do-file is kept UNMODIFIED in Program/Tables&Figures.do.
. * This wrapper:
. *   1. sets the project root (edit ROOT below, or pass it as argument 1);
. *   2. splits the author's file into one step per exhibit (at the "*Table N*"
> ,
. *      "*Figure N*" markers) and writes them to Results/_steps/;
. *   3. applies ONLY path fixes while splitting (documented in README.md):
. *        - drops the author's  cd "D:\Dropbox\princeling\"  line
. *        - `use X.dta`              -> `use "$DATA/X.dta"`
. *        - `graph save Graph "f.gph"` -> `graph save Graph "$FIG/f.gph", repl
> ace`
. *      esttab writes tableN.csv to the working directory = Results/Tables/;
. *   4. runs every step under -capture-, logging rc and seconds to
. *      Results/run_original_steps.csv, and exports every saved graph to PNG.
. *
. * Requires: reghdfe (6.x), ftools, estout, coefplot  (ssc install ...)
. *****************************************************************************
> **
. version 18

. clear all

. set more off

. set varabbrev on

. 
. args ROOTARG

. if "`ROOTARG'" == "" local ROOTARG "/Users/brycewang/Documents/GitHub/top5-Ec
> on-Paper-Replications/QJE2019-Busting-the-Princelings"

. global ROOT "`ROOTARG'"

. global DATA "$ROOT/Data"

. global TAB  "$ROOT/Results/Tables"

. global FIG  "$ROOT/Results/Figures"

. global STEP "$ROOT/Results/_steps"

. capture mkdir "$ROOT/Results"

. capture mkdir "$TAB"

. capture mkdir "$FIG"

. capture mkdir "$STEP"

. 
. * optional: run only selected steps, e.g.  global ONLY "table5 figure5"
. if "$ONLY" == "" global ONLY ""

. 
. *----------------------------------------------------------------------------
> --
. * 1. split the author's do-file into steps
. *----------------------------------------------------------------------------
> --
. * Fix 5 (not a path fix, documented in README): Table 11 has only oprobit
. * models, which have no _cons, so the esttab drop list containing _cons abort
> s
. * with r(111) coefficient _cons not found under current estout. The loop belo
> w
. * removes that one token from the Table 11 esttab call only.
. local src "$ROOT/Program/Tables&Figures.do"

. tempname fin fout

. file open `fin' using "`src'", read text

. local step "table3a"

. local steps "`step'"

. file open `fout' using "$STEP/`step'.do", write text replace

. file read `fin' line

. while r(eof) == 0 {
  2.     local l `"`macval(line)'"'
  3.     local t = strtrim(`"`macval(l)'"')
  4.     * step markers: *Table 3A*, *Table 5*, ..., *Figure 4*, ...
.     if regexm(`"`macval(t)'"', "^\*(Table|Figure) ([0-9]+[A-Z]?)\*$") {
  5.         local new = lower(regexs(1)) + lower(regexs(2))
  6.         if "`new'" != "`step'" {
  7.             file close `fout'
  8.             local step "`new'"
  9.             local steps "`steps' `step'"
 10.             file open `fout' using "$STEP/`step'.do", write text replace
 11.         }
 12.     }
 13.     * path fix 1: drop the author's Windows cd line
.     if regexm(`"`macval(t)'"', "^cd ") {
 14.         file write `fout' `"* [wrapper] removed: `macval(t)'"' _n
 15.     }
 16.     else {
 17.         * path fix 2: use X.dta -> use "$DATA/X.dta"
.         if regexm(`"`macval(l)'"', "^use ([A-Za-z0-9_]+\.dta)(.*)$") {
 18.             local l = "use " + char(34) + "\$DATA/" + regexs(1) + char(34)
>  + regexs(2)
 19.         }
 20.         * path fix 3: graph save Graph "f.gph"[, replace] -> $FIG/f.gph, r
> eplace
.         if regexm(`"`macval(l)'"', `"^graph save Graph "([A-Za-z0-9_]+\.gph)"
> (.*)$"') {
 21.             local l = "graph save Graph " + char(34) + "\$FIG/" + regexs(1
> ) + char(34) + ", replace"
 22.         }
 23.         * path fix 4: graph combine "f.gph" ... -> $FIG/f.gph
.         if regexm(`"`macval(l)'"', "^graph combine ") {
 24.             local l = subinstr(`"`macval(l)'"', char(34) + "figure7", char
> (34) + "\$FIG/figure7", .)
 25.         }
 26.         if "`step'" == "table11" & regexm(`"`macval(l)'"', "^esttab using 
> table11") {
 27.             local l = subinstr(`"`macval(l)'"', " _cons)", ")", 1)
 28.         }
 29.         file write `fout' `"`macval(l)'"' _n
 30.     }
 31.     file read `fin' line
 32. }

. file close `fout'

. file close `fin'

. di as txt "steps: `steps'"
steps: table3a table3b table5 table6 table7 table8 table9 table10 table11 figur
> e4 figure5 figure6 figure7

. 
. *----------------------------------------------------------------------------
> --
. * 2. run every step, logging rc + seconds
. *----------------------------------------------------------------------------
> --
. * the author's steps call -clear all-, which closes open file handles, so the
. * step log is reopened in append mode after every step
. if "$APPEND" == "" {
.     file open lg using "$ROOT/Results/run_original_steps.csv", write text rep
> lace
.     file write lg "step,rc,seconds" _n
.     file close lg
. }

. cd "$TAB"
/Users/brycewang/Documents/GitHub/top5-Econ-Paper-Replications/QJE2019-Busting-
> the-Princelings/Results/Tables

. foreach s of local steps {
  2.     if "$ONLY" != "" & strpos(" $ONLY ", " `s' ") == 0 continue
  3.     di as res _n "=================== `s' ==================="
  4.     timer clear 1
  5.     timer on 1
  6.     capture noisily do "$STEP/`s'.do"
  7.     local rc = _rc
  8.     timer off 1
  9.     quietly timer list 1
 10.     local sec = round(r(t1), 0.1)
 11.     file open lg using "$ROOT/Results/run_original_steps.csv", write text 
> append
 12.     file write lg "`s',`rc',`sec'" _n
 13.     file close lg
 14.     cd "$TAB"
 15.     di as res "step `s': rc=`rc'  seconds=`sec'"
 16.     * export any graph saved by the step
.     foreach g in figure4 figure5 figure6 figure7 {
 17.         if "`s'" == "`g'" {
 18.             capture graph use "$FIG/`g'.gph"
 19.             if _rc == 0 capture graph export "$FIG/`g'.png", replace width
> (1600)
 20.         }
 21.     }
 22. }


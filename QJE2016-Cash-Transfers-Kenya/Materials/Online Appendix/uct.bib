@article{friedman_psychological_2009,
	title = {Psychological health before, during, and after an economic crisis: {Results} from {Indonesia}, 1993–2000},
	volume = {23},
	issn = {0258-6770, 1564-698X},
	shorttitle = {Psychological {Health} {Before}, {During}, and {After} an {Economic} {Crisis}},
	url = {http://wber.oxfordjournals.org/content/23/1/57},
	doi = {10.1093/wber/lhn013},
	abstract = {The 1997 Indonesian financial crisis resulted in severe economic dislocation and political upheaval. Previous studies have established the detrimental consequences for economic welfare, physical health, and child education. The crisis also affected the psychological well-being of the Indonesian people. Comparing responses of the same individuals interviewed before and after the crisis, this study documents substantial increases in several dimensions of psychological distress among men and women across the age distribution. It shows larger impacts of the economic crisis on the more vulnerable groups, including those with low education, the rural landless, urban residents, and those in provinces most affected by the crisis. Elevated psychological distress persists even after the economy returns to precrisis levels, suggesting that the deleterious effects of the crisis may persist longer on the psychological well-being of the Indonesian population than on standard measures of economic well-being.},
	language = {en},
	number = {1},
	urldate = {2013-07-24},
	journal = {The World Bank Economic Review},
	author = {Friedman, Jed and Thomas, Duncan},
	year = {2009},
	keywords = {I10, O12},
	pages = {57--76}
}


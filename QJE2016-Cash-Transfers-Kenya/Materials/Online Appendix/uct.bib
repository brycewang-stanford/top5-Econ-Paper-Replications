@article{fraker_effect_1995,
	title = {The effect of food stamp cashout on food expenditures: {An} assessment of the findings from four demonstrations},
	volume = {30},
	shorttitle = {The {Effect} of {Food} {Stamp} {Cashout} on {Food} {Expenditures}},
	url = {http://econpapers.repec.org/article/uwpjhriss/v_3a30_3ay_3a1995_3ai_3a4_3ap_3a633-649.htm},
	abstract = {Using findings from four demonstrations, we examine estimates of the effect on household food expenditures of converting food stamps into a cash transfer. We provide arguments for why the estimate produced by one of the demonstrations should be regarded as an outlier. The disparity in the difference-in-means estimates from the remaining three demonstrations is reduced when each is normalized by dividing by the average value of benefits in the respective demonstration site. The normalized estimates imply a reduction in food expenditures of between 18 and 28 cents for each dollar of food stamps cashed out. At the aggregate level, these estimates imply that nationwide cashout would result in a reduction in household food spending of between 4.2 and 6.5 billion dollars, whereas the associated reduction in the cost of administering the Food Stamp Program would be about 0.3 billion dollars.},
	number = {4},
	urldate = {2013-07-24},
	journal = {Journal of Human Resources},
	author = {Fraker, Thomas M. and Martini, Alberto Paolo and Ohls, James C.},
	year = {1995},
	pages = {633--649}
}


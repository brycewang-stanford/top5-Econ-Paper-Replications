 81.                 test [spec1_2_mean]spillover = [spec1_1_mean]spillover
 82.                 pstar, p(`r(p)') pstar pnopar
 83.                 estadd local thisstat`count' "`r(pstar)'": col5
 84. 
.                 *** COLUMN 6: USING SUR TO TEST EQUIVALENCE ***
.                 suest spec2_1 spec2_2, cluster(village)
 85.                 test[spec2_2_mean]spillover = [spec2_1_mean]spillover
 86.                 pstar, p(`r(p)') pstar pnopar
 87.                 estadd local thisstat`count' "`r(pstar)'": col6
 88. 
. *       NOTE: LEE BOUNDS ARE RUN ON THE DIFFERENTIAL PROPORTION OF UPGRADERS 
> BETWEEN TV AND CV
. 
.                 *** LEE and Manski bounds BOUNDS MODEL ***
.                 preserve
 89.                 if "`hhcase'" == "1" & "`var'" ~= "psy_index_z" {
 90.                         drop if maleres
 91.                         local x = _N + 1
 92.                         local y = `x' + 4
 93.                         set obs `y'
 94.                         replace purecontrol = 0 in `x'/`y'
 95.                         replace treat = 0 in `x'/`y'
 96.                         replace spillover = 1 in `x'/`y'
 97.                         replace `thisvarname' = . in `x'/`y'
 98.                         replace endlinedate = 1 in `x'/`y'
 99.                         gen select = 1 in `x'/`y'
100.                         recode select . = 0
101.                 }
102.                 else if "`indcase'" == "1" | "`var'" == "psy_index_z" {
103.                         local x = _N + 1
104.                         local y = `x' + 9
105.                         set obs `y'
106.                         replace purecontrol = 0 in `x'/`y'
107.                         replace treat = 0 in `x'/`y'
108.                         replace spillover = 1 in `x'/`y'
109.                         replace endlinedate = 1 in `x'/`y'
110.                         replace `thisvarname' = . in `x'/`y'
111.                         gen select = 1 in `x'/`y'
112.                         recode select . = 0
113.                 }
114. 
.                 leebounds `thisvarname' spillover, cieffect vce(bootstrap, re
> ps(100))
115. 
.                 *** COLUMN 7: LOWER LEE BOUND ***
.                 pstar lower, prec(2)
116.                 estadd loc thisstat`count' = "`r(bstar)'": col7
117.                 estadd loc thisstat`countse' = "`r(sestar)'": col7
118. 
.                 *** COLUMN 8: UPPER LEE BOUND ***
.                 pstar upper, prec(2)
119.                 estadd loc thisstat`count' = "`r(bstar)'": col8
120.                 estadd loc thisstat`countse' = "`r(sestar)'": col8
121. 
. 
.                 **** MANSKI ****
.                 gen `var'LO1 = `var'1
122.                 gen `var'HI1 = `var'1
123.                 sum `var'LO1 if ~select, detail
124.                 replace `var'LO1 = `r(p5)' if select
125.                 replace `var'HI1 = `r(p95)' if select
126.                 sum `var'LO1 `var'HI1 `var'1
127. 
.                 *** Column 9: UPPER MANSKI BOUND ***
.                 reg `var'LO1  spillover, r
128.                 pstar spillover, prec(2)
129.                 estadd loc thisstat`count' = "`r(bstar)'": col9
130.                 estadd loc thisstat`countse' = "`r(sestar)'": col9
131. 
.                 *** Column 10: LOWER MANSKI BOUND ***
.                 reg `var'HI1 spillover, r
132.                 pstar spillover, prec(2)
133.                 estadd loc thisstat`count' = "`r(bstar)'": col10
134.                 estadd loc thisstat`countse' = "`r(sestar)'": col10
135. 
. 
.                 restore
136. 
. 
.                 *** SAVE AND ITERATE ***
. 
.                 local thisvarlabel: variable label `thisvarname'
137.                 if `count' == 1 local varlabels "`varlabels' "\midrule `th
> isvarlabel'" " " "
138.                 else local varlabels "`varlabels' "`thisvarlabel'" " " "
139.                 local statnames "`statnames' thisstat`count' thisstat`coun
> tse'"
140. 
.                 local count = `count' + 2
141.                 local countse = `count' + 1
142.         }
143. 
.         *** ADD SUR ROW ***
.         use `usedata', clear
144. 
.         local suestcount = 1
145.         local suest1 "suest "
146.         local suest2 "suest "
147.         local suest3 "suest "
148.         local suest4 "suest "
149. 
.         foreach var in $`thisvarlist' {
150. 
.                 local thisvarname "`var'1"
151.                 if `hhcase' == 1 & "`var'" == "psy_index_z" replace includ
> e = 1 if maleres
152.                 if `hhcase' == 1 & "`var'" ~= "psy_index_z" replace includ
> e = 0 if maleres
153. 
.                 *** WEIGHTS FOR OUTCOMES AT THE INDIVIDUAL LEVEL ***
.                 cap drop weight weight2
154.                 bysort surveyid: egen weight = count(`thisvarname') if inc
> lude == 1
155.                 bysort village: egen weight2 = count(`thisvarname') if inc
> lude == 1
156.                 replace weight2 =  1 / weight2 / weight
157.                 replace weight = 1 / weight
158. 
.                 reg `thisvarname' spillover if include == 1 `thisweighting'
159.                 est store spec1_`suestcount'
160.                 local suest1 "`suest1' spec1_`suestcount'"
161.                 reg `thisvarname' spillover $spillovercontrols if include 
> == 1 `thisweighting'
162.                 est store spec2_`suestcount'
163.                 local suest2 "`suest2' spec2_`suestcount'"
164.                 reg `thisvarname' spillover if include == 1 & asset_nicero
> of1 ~=1 `thisweighting'
165.                 est store spec3_`suestcount'
166.                 local suest3 "`suest3' spec3_`suestcount'"
167.                 reg `thisvarname' spillover $spillovercontrols if include 
> == 1 & asset_niceroof1 ~=1 `thisweighting'
168.                 est store spec4_`suestcount'
169.                 local suest4 "`suest4' spec4_`suestcount'"
170.                 local ++suestcount
171. 
.         }
172. 
.         `suest1', cluster(village)
173.         test spillover
174.         pstar, p(`r(p)') pstar pnopar
175.         estadd local testp "`r(pstar)'": col1

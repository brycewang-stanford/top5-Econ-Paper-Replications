. *** REGRESSIONS FOR EACH ENDLINE OUTCOME ***
.         foreach var in $`thisvarlist' {
 46. 
.                 use `usedata', clear
 47.                 local thisvarname "`var'1"
 48. 
.                 // The Psych Index is individual level, so it is treated diff
> erent from other variables in the index list.
.                 if "`var'" == "psy_index_z" replace include = 1 if maleres
 49.                 if `hhcase' == 1 & "`var'" ~= "psy_index_z" local thisweig
> hting ""
 50. 
.                 *** WEIGHTS FOR OUTCOMES AT THE INDIVIDUAL LEVEL ***
.                 cap drop weight weight2
 51.                 bysort surveyid: egen weight = count(`thisvarname') if inc
> lude == 1
 52.                 bysort village: egen weight2 = count(`thisvarname') if inc
> lude == 1
 53.                 replace weight2 =  1 / weight2 / weight
 54.                 replace weight = 1 / weight
 55. 
.                 *** COLUMN 1: INCLUDES METAL ROOF SPILLOVERS ***

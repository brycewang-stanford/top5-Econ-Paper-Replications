. version 13.1 

. set more off

. sysdir set PERSONAL "${ado_dir}"

. 
. foreach thisvarlist in  $regvars {
  2. 
. *** CREATE EMPTY TABLE ***
.         clear all
  3.         set obs 10
  4.         gen x = 1
  5.         gen y = 1
  6. 
.         forvalues x = 1/9 {
  7.                 eststo col`x': reg x y
  8.         }
  9.         
.         local varcount = 1
 10.         local count = 1
 11.         local countse = `count'+1
 12.         local varlabels ""
 13.         local statnames ""
 14.         
. 
. *** DENOTE HOUSEHOLD VS INDIVIDUAL OUTCOMES ***
.         
.         if "`thisvarlist'" == "psyvars" | "`thisvarlist'" == "psyvars_weighte
> d" | "`thisvarlist'" == "politicalvars" local hhcase = 0
 15.         else local hhcase = 1
 16.         
.         // weighting will be by the number of observations per household, as 
> this is not necessarily balanced.
.         if "`thisvarlist'" == "indices_weighted" | "`thisvarlist'" == "psyvar
> s_weighted" local thisweighting "[aw=weight]"
 17.         else local thisweighting ""
 18.         
.         
. *** DATASET *** 
.         use "$data_dir/UCT_FINAL_CLEAN.dta", clear
 19.         drop if endlinedate == .
 20.         drop if purecontrol == 1
 21.         tempfile usedata
 22.         save `usedata'
 23. 
.         
. *** REGRESSIONS AND POWER CALCULATIONS ***
.         foreach var in $`thisvarlist' {
 24. 
.                 use `usedata', clear
 25.                 local thisvarname "`var'1"
 26. 
.                 // The Psych Index is individual level, so it is treated diff
> erent from other variables in the index list.
.                 if `hhcase' == 1 & "`var'" ~= "psy_index_z" drop if maleres
 27.                 
.                 *** COLUMNS 1: CONTROL MEAN ***
.                 sum `thisvarname' if spillover
 28.                 local controlmean = round(r(mean),.01)
 29.                 if "`var'" == "psy_lncort_mean_clean" local controlmean = 
> 2.46
 30.                 estadd local thisstat`count' = string(`controlmean', "%9.2
> f") : col1
 31.                 estadd local thisstat`countse' = "(" + string(`r(sd)', "%9
> .2f") + ")" : col1
 32.                 
.                 *** COLUMNS 2-3: TREATMENT EFFECT ***
.                 areg `thisvarname' treat `var'_full0 `var'_miss0, absorb(vill
> age) cluster(surveyid)
 33.                 local MDE = _se[treat] * 2.8
 34.                 local pctMDE = abs(`MDE' / `controlmean')
 35.                 estadd local thisstat`count' = string(`MDE', "%9.2f"): col
> 2
 36.                 if abs(`controlmean') > 0 estadd local thisstat`count' = s
> tring(`pctMDE', "%9.2f"): col3
 37.                 else estadd local thisstat`count' = "{ }": col3
 38.                 
.                 *** COLUMNS 4-5: FEMALE RECIPIENT ***
.                 areg `thisvarname' treatXfemalerecXmarried treatXsinglerec sp
> illover `var'_full0 `var'_miss0, absorb(village) cluster(surveyid)
 39.                 local MDE = _se[treatXfemalerecXmarried] * 2.8
 40.                 local pctMDE = abs(`MDE' /`controlmean')
 41.                 estadd local thisstat`count' = string(`MDE', "%9.2f"): col
> 4
 42.                 if abs(`controlmean') > 0 estadd local thisstat`count' = s
> tring(`pctMDE', "%9.2f"): col5
 43.                 else estadd local thisstat`count' = "{ }": col5
 44.                 
.                 *** COLUMNS 6-7: MONTHLY TRANSFER ***
.                 areg `thisvarname' treatXmonthlyXsmall treatXlarge spillover 
> `var'_full0 `var'_miss0 if ~purecontrol, absorb(village) cluster(surveyid)
 45.                 local MDE = _se[treatXmonthlyXsmall] * 2.8
 46.                 local pctMDE = abs(`MDE' /`controlmean')
 47.                 estadd local thisstat`count' = string(`MDE', "%9.2f"): col
> 6
 48.                 if abs(`controlmean') > 0 estadd local thisstat`count' = s
> tring(`pctMDE', "%9.2f"): col7
 49.                 else estadd local thisstat`count' = "{ }": col7
 50.                 
.                 *** COLUMNS 8-9: LARGE TRANSFER ***
.                 areg `thisvarname' treatXlarge spillover `var'_full0 `var'_mi
> ss0, absorb(village) cluster(surveyid)
 51.                 local MDE = _se[treatXlarge] * 2.8
 52.                 local pctMDE = abs(`MDE' /`controlmean')
 53.                 estadd local thisstat`count' = string(`MDE', "%9.2f"): col
> 8
 54.                 if abs(`controlmean') > 0 estadd local thisstat`count' = s
> tring(`pctMDE', "%9.2f"): col9
 55.                 else estadd local thisstat`count' = "{ }": col9
 56.                 
.                 local thisvarlabel: variable label `thisvarname'
 57.                 local varlabels "`varlabels' "`thisvarlabel'" " " "
 58.                 local statnames "`statnames' thisstat`count' thisstat`coun
> tse'"
 59.                 
.                 local count = `count' + 2
 60.                 local countse = `count' + 1
 61. 
.                 }
 62.         
.         
.         esttab col* using "$output_dir/`thisvarlist'_power_calcs.tex",  cells
> (none) booktabs nonotes compress replace mgroups("" "Treatment Effect" "Femal
> e Recipient" "Monthly Transfer" "Large Transfer", pattern(1 1 0 1 0 1 0 1 0) 
> prefix(\multicolumn{@span}{c}{) suffix(}) span erepeat(\cmidrule(lr){@span}))
>  alignment(SSSSSSSSSSSS) mtitle("\specialcell{Control\\Mean}" "\specialcell{M
> DE}" "\specialcell{Percent of\\Control Mean}" "\specialcell{MDE}" "\specialce
> ll{Percent of\\Control Mean}" "\specialcell{MDE}" "\specialcell{Percent of\\C
> ontrol Mean}" "\specialcell{MDE}" "\specialcell{Percent of\\Control Mean}") s
> tats(`statnames', labels(`varlabels') ) 

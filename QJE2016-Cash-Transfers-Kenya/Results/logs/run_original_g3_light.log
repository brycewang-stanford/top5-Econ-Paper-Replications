end of do-file
.         do "$do_dir/UCT_Temporal_Evolution_Figure.do"

. clear all

. version 13.1 

. set more off

. sysdir set PERSONAL "${ado_dir}"

. 
. foreach thisvarlist in $regvars {
  2.         
.         
. *** DATASET *** 
.         use "$data_dir/UCT_FINAL_CLEAN.dta", clear
  3.         drop if purecontrol == 1
  4.         drop if endlinedate == .
  5.         xi i.village, pref(fev) // village fixed effects
  6.         
.         *** TIME OF TRANSFER ***
.         gen treatend_0 = (Dlastend <= 1 & treat == 1)
  7.         gen treatend_1_4 = (Dlastend > 1 & Dlastend <= 4 & treat == 1)
  8.         gen treatend_4_14 = (Dlastend > 4 & treat == 1)
  9.         
.         foreach treatx in treatXlumpXsmall treatXmonthlyXsmall {
 10.                 foreach end in 0 1_4 4_14 {
 11.                         gen tend_`end'`treatx' = (`treatx' == 1 & treatend
> _`end' == 1)
 12.                 }
 13.         }
 14.         
.         tempfile usedata
 15.         save `usedata'
 16. 
.         
. *** TRACK ITERATIONS ***
.         local count = 1
 17.         local countse = `count'+1
 18.         local varlabels ""
 19.         local statnames ""
 20.         local statnames_abbrev ""
 21.         local varlabels_abbrev ""       
 22.         
.         
. *** CYCLE THROUGH VARIABLES ***
.         foreach var in $`thisvarlist' {
 23.         
.         use `usedata', clear
 24.         local thisvarname "`var'1"
 25. 
.         // The Psych Index is individual level, so it is treated different fr
> om other variables in the index list.
.         if "`var'" ~= "psy_index_z" drop if maleres == 1
 26.         drop if `thisvarname' == .
 27. 
.         
.         *** BASIC RESULTS ***
.         areg `thisvarname' treat treatXlarge `var'_full0 `var'_miss0, cluster
> (surveyid) absorb(village) 
 28.         gen b_`thisvarname' = . 
 29.         gen se_`thisvarname' = . 
 30.         replace b_`thisvarname' = _b[treat] in 1
 31.         replace se_`thisvarname' = _se[treat] in 1
 32.         
.         
.         *** TEMPORAL DYNAMICS ***
.         areg `thisvarname' tend* treatXlarge `var'_full0 `var'_miss0, absorb(
> village) cluster(surveyid) 
 33.         local coeffcount = 2
 34.         foreach thisdelay of varlist tend* { 
 35.                 replace b_`thisvarname' = _b[`thisdelay'] in `coeffcount'
 36.                 replace se_`thisvarname' = _se[`thisdelay'] in `coeffcount
> '
 37.                 local N_`thisvarname' = e(N)
 38.                 local ++coeffcount
 39.         }
 40.         
.         test tend_0treatXlumpXsmall tend_0treatXmonthlyXsmall
 41.         local `thisvarname'p0 = string(round(r(p),.01),"%9.2f")
 42.         test tend_1_4treatXlumpXsmall tend_1_4treatXmonthlyXsmall
 43.         local `thisvarname'p1_4 = string(round(r(p),.01),"%9.2f")
 44.         test tend_4_14treatXlumpXsmall tend_4_14treatXmonthlyXsmall 
 45.         local `thisvarname'p4_14 = string(round(r(p),.01),"%9.2f")
 46. 
.         *** GRAPH IT ***
.         cap drop b_hi  b_lo
 47.         gen b_hi = b_`thisvarname' + 1.64 * se_`thisvarname'
 48.         gen b_lo = b_`thisvarname' - 1.64 * se_`thisvarname'
 49. 
.         cap drop order
 50.         gen order = ((_n-1)+_n)*.6 if b_`thisvarname' ~=.
 51.         forvalues j = 1/13 {
 52.                 local order`j' = order[`j']
 53.         }
 54. 
.         local lab: variable label `thisvarname'
 55.         #delimit ;
delimiter now ;
.         local ylabel "";
 56.         if strpos("cons_total ent_totalincome","`var'") >0 {;
 57.                 local ylabel "-3000 0 3000 6000";

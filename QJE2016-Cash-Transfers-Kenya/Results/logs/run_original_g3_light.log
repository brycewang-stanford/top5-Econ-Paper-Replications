. *** ADD STATISTICS ***
. foreach var in $immutable_baseline {    
  2.         
.         *** COLUMN 1: Treatment Village Mean ***
.         sum `var' if control_village == 0
  3.         local mean = string(r(mean), "%9.2f")
  4.         estadd local thisstat`count' = "`mean'": col1
  5.         local sd = "(" + string(r(sd), "%9.2f")+ ")"
  6.         estadd local thisstat`countse' = "`sd'": col1
  7.         
.         
.         *** COLUMN 2: Control Village Mean ***
.         sum `var' if control_village == 1
  8.         local mean = string(r(mean), "%9.2f")
  9.         estadd local thisstat`count' = "`mean'": col2
 10.         local sd = "(" + string(r(sd), "%9.2f")+ ")"
 11.         estadd local thisstat`countse' = "`sd'": col2
 12.         
.         
.         *** COLUMN 3: Control Village Effect ***
.         reg `var' control_village, cluster(village)

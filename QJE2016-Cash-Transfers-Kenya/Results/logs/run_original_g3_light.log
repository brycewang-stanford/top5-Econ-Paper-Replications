  5.                 use "$data_dir/UCT_FINAL_CLEAN.dta", clear
  6.                 drop if endlinedate ==. 
  7. 
. 
. 
.                 *** CREATE EMPTY TABLE ***
.                 gen fakex = 1
  8.                 gen fakey = 1
  9.                 local totalcols = 7
 10.                 forvalues x = 1/`totalcols' {
 11.                         eststo col`x': reg fakex fakey
 12.                 }
 13. 
. 
.                 *** TRACK ITERATIONS ***
.                 local count = 1
 14.                 local countse = `count'+ 1
 15.                 local statnames ""
 16.                 local varlabels ""
 17. 
.                 *** REGRESSIONS ***
.                 foreach var in $`thisvarlist' {
 18.                 
.                         *** COLUMN 1: CONTROL MEAN ***
.                         sum `var'1 if spillover & `gender' == 1
 19.                         estadd local thisstat`count' = string(`r(mean)', "
> %9.2f") : col1
 20.                         estadd local thisstat`countse' = "(" + string(`r(s
> d)', "%9.2f") + ")" : col1
 21.                         
.                         *** COLUMN 2: FEMALE RECIPIENT IN VILLAGE  ***
.                         areg `var'1 treatXfemalerecXmarried treatXmalerecXmar
> ried treatXsinglerec spilloverXsingle `var'_full0 `var'_miss0 if `gender' == 
> 1 & purecontrol == 0, absorb(village) cluster(surveyid) 
 22.                         pstar treatXfemalerecXmarried
 23.                         estadd local thisstat`count' = "`r(bstar)'": col2
 24.                         estadd local thisstat`countse' = "`r(sestar)'": co
> l2
 25.                         
.                         *** COLUMN 3: MALE RECIPIENT IN VILLAGE  ***
.                         areg `var'1 treatXfemalerecXmarried treatXmalerecXmar
> ried treatXsinglerec spilloverXsingle `var'_full0 `var'_miss0 if `gender' == 
> 1 & purecontrol == 0, absorb(village) cluster(surveyid) 
 26.                         pstar treatXmalerecXmarried
 27.                         estadd local thisstat`count' = "`r(bstar)'": col3
 28.                         estadd local thisstat`countse' = "`r(sestar)'": co
> l3
 29.                         
.                         *** COLUMN 4: FEMALE VS MALE RECIPIENT ***
.                         areg `var'1 treatXfemalerecXmarried treatXsinglerec s
> pillover `var'_full0 `var'_miss0 if `gender' == 1 & purecontrol == 0, absorb(
> village) cluster(surveyid) 
 30.                         pstar treatXfemalerecXmarried
 31.                         estadd local thisstat`count' = "`r(bstar)'": col4
 32.                         estadd local thisstat`countse' = "`r(sestar)'": co
> l4
 33.                         
.                         *** COLUMN 5: FEMALE RECIPIENT BETWEEN VILLAGE  ***
.                         reg `var'1 treatXfemalerecXmarried treatXmalerecXmarr
> ied treatXsinglerec spillover purecontrolXsingle if `gender' == 1, cluster(vi
> llage) 
 34.                         pstar treatXfemalerecXmarried
 35.                         estadd local thisstat`count' = "`r(bstar)'": col5
 36.                         estadd local thisstat`countse' = "`r(sestar)'": co
> l5
 37.                         
.                         *** COLUMN 6: MALE RECIPIENT BETWEEN VILLAGE  ***
.                         reg `var'1 treatXfemalerecXmarried treatXmalerecXmarr
> ied treatXsinglerec spillover purecontrolXsingle if `gender' == 1, cluster(vi
> llage) 
 38.                         pstar treatXmalerecXmarried
 39.                         estadd local thisstat`count' = "`r(bstar)'": col6
 40.                         estadd local thisstat`countse' = "`r(sestar)'": co
> l6
 41.                         
.                         *** COLUMN 7: OBSERVATIONS ***
.                         sum `var'1 if `gender' == 1
 42.                         local thisN = `r(N)'
 43.                         estadd scalar thisstat`count' = `thisN': col7
 44.                         
.                         *** ITERATE ***
.                         local thisvarlabel: variable label `var'1
 45.                         local varlabels "`varlabels' "`thisvarlabel'" " " 
> "
 46.                         local statnames "`statnames' thisstat`count' thiss
> tat`countse'"
 47.                         local count = `count' + 2
 48.                         local countse = `count' + 1
 49.                 }
 50. 
.                         
.                 *** JOINT ESTIMATION ROW ***
.                 xi i.village, pref(fev)
 51.                 local suestcount = 1
 52.                 local suest1 "suest " 
 53.                 local suest2 "suest " 
 54.                 local suest3 "suest " 
 55.                 local suest4 "suest " 
 56.                 local suest5 "suest " 
 57.                 // Store for suest
.                 foreach var in $`thisvarlist' {
 58.                         reg `var'1 treatXfemalerecXmarried treatXmalerecXm
> arried treatXsinglerec `var'_full0 `var'_miss0 fev* if `gender' == 1 & pureco
> ntrol == 0
 59.                         est store spec1_`suestcount'
 60.                         local suest1 "`suest1' spec1_`suestcount'"
 61.                         reg `var'1 treatXfemalerecXmarried treatXmalerecXm
> arried treatXsinglerec `var'_full0 `var'_miss0 fev* if `gender' == 1 & pureco
> ntrol == 0
 62.                         est store spec2_`suestcount'
 63.                         local suest2 "`suest2' spec2_`suestcount'"
 64.                         reg `var'1 treatXfemalerecXmarried treatXsinglerec
>  spillover `var'_full0 `var'_miss0 fev* if `gender' == 1 & purecontrol == 0
 65.                         est store spec3_`suestcount'

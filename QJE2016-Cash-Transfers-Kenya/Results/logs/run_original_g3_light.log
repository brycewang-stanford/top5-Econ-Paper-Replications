. version 13.1 

. set more off

. sysdir set PERSONAL "${ado_dir}"

. 
. foreach thisvarlist in $regvars  {
  2. 
. 
. *** CREATE EMPTY TABLE ***
.         clear all
  3.         set obs 10
  4.         gen x = 1
  5.         gen y = 1
  6. 
.         forvalues x = 1/2 {
  7.                 eststo col`x': reg x y
  8.         }
  9.         
.         local varcount = 1
 10.         local count = 1
 11.         local countse = `count'+1
 12.         local varlabels ""
 13.         local statnames ""
 14.         
. *** DATASET *** 
.         use "$data_dir/UCT_FINAL_CLEAN.dta", clear
 15.         cap drop weight
 16.         drop if purecontrol == 1
 17.         //GENERATE VILLAGE MEAN TRANSFER AMOUNT
.         gen treat_amount = 1525*treatXlarge + 404*treatXsmall
 18.         egen mean_chg = mean(treat_amount), by(village)
 19.         replace mean_chg = mean_chg / 100
 20.         drop if endlinedate == .
 21.         drop if treat == 1
 22.         gen include = 1
 23.         replace include = 0 if maleres == 1
 24.         tempfile usedata
 25.         save `usedata'
 26.         
.         
. *** REGRESSIONS FOR EACH ENDLINE OUTCOME ***
.         foreach var in $`thisvarlist' {
 27.         
.                 use `usedata', clear
 28.                 local thisvarname "`var'1"
 29. 
.                 // The Psych Index is individual level, so it is treated diff
> erent from other variables in the index list.
.                 if "`var'" == "psy_index_z" replace include = 1 if maleres ==
>  1
 30.         
.                 
.                 *** COLUMN 1: MEAN CHANGE ***
.                 reg `thisvarname' mean_chg `var'_full0 `var'_miss0 if include
>  == 1, cluster(village)
 31.                 pstar mean_chg
 32.                 estadd local thisstat`count' = "`r(bstar)'": col1
 33.                 estadd local thisstat`countse' = "`r(sestar)'": col1
 34.                 
.                 *** Column 2: N ***
.                 local thisN = e(N)
 35.                 estadd scalar thisstat`count' = `thisN': col2
 36.                 
.                 *** SAVE AND ITERATE ***
.                 local thisvarlabel: variable label `thisvarname'
 37.                 local varlabels "`varlabels' "`thisvarlabel'" " " "
 38.                 local statnames "`statnames' thisstat`count' thisstat`coun
> tse'"
 39.                 
.                 local count = `count' + 2
 40.                 local countse = `count' + 1
 41.         }
 42. 
.         
. *** JOINT ESTIMATION ROW ***
. use `usedata', clear
 43.         
. // store individual regressions for suest
. local suestcount = 1
 44. local suest1 "suest "   
 45. foreach var in $`thisvarlist' {
 46. 
.         local thisvarname "`var'1"
 47.                 
.         if "`var'" == "psy_index_z" replace include = 1 if maleres == 1
 48.         if "`var'" ~= "psy_index_z" replace include = 0 if maleres == 1
 49.         
.         reg `thisvarname' mean_chg `var'_full0 `var'_miss0 if include == 1
 50.         estimate store spec1_`suestcount'
 51.         local suest1 "`suest1' spec1_`suestcount'" 
 52.         local ++suestcount
 53. 
. }
 54. 
. // run joint test and store
. `suest1', cluster(village)
 55. 
. test mean_chg
 56. pstar, p(`r(p)') pstar pnopar
 57. estadd local testp "`r(pstar)'": col1
 58. 
. local statnames "`statnames' testp" 
 59. local varlabels "`varlabels' "\midrule Joint test (\emph{p}-value)" " 
 60. 
. 
. *** OUTPUT ***
. esttab col* using "$output_dir/InVillage_Spillover.tex",  cells(none) booktab
> s nonotes compress replace alignment(Sc) mtitle("\specialcell{Village Mean\\C
> hange}" "N" ) stats(`statnames', labels(`varlabels') )
 61. 
. }

 60.                 estadd local thisstat`countse' = "`r(sestar)'": col1
 61. 
.                 *** COLUMN 2: WITH CONTROLS ***
.                 reg `thisvarname' spillover $spillovercontrols if include == 
> 1 `thisweighting'
 62.                 est store spec2_1
 63.                 reg `thisvarname' spillover $spillovercontrols if include 
> == 1 `thisweighting', cluster(village)
 64.                 pstar spillover
 65.                 estadd local thisstat`count' = "`r(bstar)'": col2
 66.                 estadd local thisstat`countse' = "`r(sestar)'": col2
 67. 
.                 *** EXCLUDING METAL ROOFS ***
.                 replace include = 0 if asset_niceroof1 == 1 // Exclude metal 
> roofs from these
 68. 
.                 *** COLUMN 3: EXCLUDES METAL ROOF SPILLOVERS ***
.                 reg `thisvarname' spillover if include == 1 `thisweighting'
 69.                 est store spec1_2
 70.                 reg `thisvarname' spillover if include == 1 `thisweighting
> ', cluster(village)
 71.                 pstar spillover
 72.                 estadd local thisstat`count' = "`r(bstar)'": col3
 73.                 estadd local thisstat`countse' = "`r(sestar)'": col3
 74. 
.                 *** COLUMN 4: WITH CONTROLS ***
.                 reg `thisvarname' spillover $spillovercontrols if include == 
> 1 `thisweighting'
 75.                 est store spec2_2
 76.                 reg `thisvarname' spillover $spillovercontrols if include 
> == 1 `thisweighting', cluster(village)
 77.                 pstar spillover
 78.                 estadd local thisstat`count' = "`r(bstar)'": col4
 79.                 estadd local thisstat`countse' = "`r(sestar)'": col4
 80. 
.                 *** COLUMN 5: USING SUR TO TEST EQUIVALENCE ***
.                 suest spec1_1 spec1_2, cluster(village)
 81.                 test [spec1_2_mean]spillover = [spec1_1_mean]spillover
 82.                 pstar, p(`r(p)') pstar pnopar

. 
. *** REGRESSIONS FOR EACH BASELINE VARIABLE ***
.         foreach var in $`thisvarlist' {
 40. 
.                 use `usedata', clear
 41.                 if "`thisvarlist'" == "baselinecontrols" local thisvarname
>  "`var'"

 27.                 estadd loc thisstat`count' = "`r(bstar)'": col1
 28.                 estadd loc thisstat`countse' = "`r(sestar)'": col1
 29. 
.                 *** COLUMN 2: UPPER LEE BOUND ***
.                 pstar upper, prec(2)
 30.                 estadd loc thisstat`count' = "`r(bstar)'": col2
 31.                 estadd loc thisstat`countse' = "`r(sestar)'": col2
 32. 
.                 *** ITERATE ***
.                 local thisvarlabel: variable label `var'1
 33.                 local varlabels "`varlabels' "`thisvarlabel'" " " "
 34.                 local statnames "`statnames' thisstat`count' thisstat`coun
> tse'"
 35.                 local count = `count' + 2
 36.                 local countse = `count' + 1
 37.         }
 38.         esttab * using "$output_dir/leebounds_`thisvarlist'.tex",  cells(n
> one) booktabs nonotes compress replace alignment(SS) mtitle("\specialcell{Low
> er\\bound}" "\specialcell{Upper\\bound}" ) stats(`statnames', labels(`varlabe
> ls') ) nonumbers
 39. }

 14.         estadd local thisstat`count' = "`r(bstar)'": col3
 15.         estadd local thisstat`countse' = "`r(sestar)'": col3
 16.         
.         *** ITERATE ***
.         local thisvarlabel: variable label `var'
 17.         local varlabels "`varlabels' "`thisvarlabel'" " " "
 18.         local statnames "`statnames' thisstat`count' thisstat`countse'"
 19.         local count = `count' + 2
 20.         local countse = `count' + 1
 21. }


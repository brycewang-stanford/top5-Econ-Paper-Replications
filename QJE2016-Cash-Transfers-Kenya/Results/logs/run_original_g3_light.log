 19.                 pstar treatXfemalerecXmarried
 20.                 estadd local thisstat`count' = "`r(bstar)'": col3
 21.                 estadd local thisstat`countse' = "`r(sestar)'": col3
 22.                 
.                 *** COLUMN 4: MONTHLY TRANSFER ***
.                 areg `var'1 treatXmonthlyXsmall treatXlarge spillover `var'_f
> ull0 `var'_miss0, absorb(village) cluster(surveyid) 
 23.                 pstar treatXmonthlyXsmall
 24.                 estadd local thisstat`count' = "`r(bstar)'": col4
 25.                 estadd local thisstat`countse' = "`r(sestar)'": col4
 26.                 
.                 *** COLUMN 5: LARGE TRANSFER ***
.                 areg `var'1 treatXlarge spillover `var'_full0 `var'_miss0, ab
> sorb(village) cluster(surveyid) 
 27.                 pstar treatXlarge
 28.                 estadd local thisstat`count' = "`r(bstar)'": col5
 29.                 estadd local thisstat`countse' = "`r(sestar)'": col5
 30.                 
.                 *** COLUMN 6: OBSERVATIONS ***
.                 sum `var'1
 31.                 local thisN = `r(N)'
 32.                 estadd scalar thisstat`count' = `thisN': col6
 33.                 
.                 *** ITERATE ***
.                 local thisvarlabel: variable label `var'1
 34.                 local varlabels "`varlabels' "`thisvarlabel'" " " "
 35.                 local statnames "`statnames' thisstat`count' thisstat`coun
> tse'"
 36.                 local count = `count' + 2
 37.                 local countse = `count' + 1
 38.         }
 39.         
.         
. *** JOINT ESTIMATION ROW ***
.         xi i.village, pref(fev)
 40.         local suestcount = 1
 41.         local suest1 "suest " 
 42.         local suest2 "suest " 
 43.         local suest3 "suest " 
 44.         local suest4 "suest " 
 45.         // Store for suest
.         foreach var in $`group' {
 46.                 reg `var'1 treat `var'_full0 `var'_miss0 fev*
 47.                 est store spec1_`suestcount'
 48.                 local suest1 "`suest1' spec1_`suestcount'"
 49.                 reg `var'1 treatXfemalerecXmarried treatXsinglerec spillov
> er `var'_full0 `var'_miss0 fev*
 50.                 est store spec2_`suestcount'
 51.                 local suest2 "`suest2' spec2_`suestcount'"
 52.                 reg `var'1 treatXmonthlyXsmall treatXlarge spillover `var'
> _full0 `var'_miss0 fev*
 53.                 est store spec3_`suestcount'
 54.                 local suest3 "`suest3' spec3_`suestcount'"
 55.                 reg `var'1 treatXlarge spillover `var'_full0 `var'_miss0 f
> ev*
 56.                 est store spec4_`suestcount'
 57.                 local suest4 "`suest4' spec4_`suestcount'"
 58.                 local ++suestcount
 59.         }
 60.         
.         // SUR
.         `suest1', cluster(surveyid) 
 61.         test treat
 62.         pstar, p(`r(p)') pstar pnopar
 63.         local testp`group' "`r(pstar)'"
 64.         estadd local testp`group' "`testp`group''": col2
 65.         
.         `suest2', cluster(surveyid) 
 66.         test treatXfemalerecXmarried
 67.         pstar, p(`r(p)') pstar pnopar
 68.         local testp`group' "`r(pstar)'"
 69.         estadd local testp`group' "`testp`group''": col3
 70.         
.         `suest3', cluster(surveyid) 
 71.         test treatXmonthlyXsmall
 72.         pstar, p(`r(p)') pstar pnopar
 73.         local testp`group' "`r(pstar)'"
 74.         estadd local testp`group' "`testp`group''": col4
 75.         
.         `suest4', cluster(surveyid) 
 76.         test treatXlarge
 77.         pstar, p(`r(p)') pstar pnopar
 78.         local testp`group' "`r(pstar)'"
 79.         estadd local testp`group' "`testp`group''": col5
 80.         
.         local statnames "`statnames' testp`group'" 
 81.         local varlabels "`varlabels' "\midrule Joint test (\emph{p}-value)
> " " 
 82.         
. }


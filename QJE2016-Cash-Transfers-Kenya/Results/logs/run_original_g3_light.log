> maleres == 1
 27.                         local thisvarlist0 "`thisvarlist0' `var'0"
 28.                 }
 29.                 
.                 set seed 1073741823             
 30.                 stepdown reg (`thisvarlist0') treat fev*, options(cluster(
> surveyid)) iter($stepdowniternow)     
 31.                 mat A = r(p)
 32.                 stepdown reg (`thisvarlist0') treatXfemalerecXmarried trea
> tXsinglerec spillover fev*, options(cluster(surveyid)) iter($stepdowniternow)
>  
 33.                 mat B = r(p)
 34.                 stepdown reg (`thisvarlist0') treatXmonthlyXsmall treatXla
> rge spillover fev*, options(cluster(surveyid)) iter($stepdowniternow) 
 35.                 mat C = r(p)
 36.                 stepdown reg (`thisvarlist0') treatXlarge spillover fev*, 
> options(cluster(surveyid)) iter($stepdowniternow)     
 37.                 mat D = r(p)
 38.         }

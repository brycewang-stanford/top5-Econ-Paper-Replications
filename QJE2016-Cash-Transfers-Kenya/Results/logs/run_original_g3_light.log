. //Section 5: Description of Censusing and Recruitment
. //Section 5.3: Unmatched Households
. if $OASection5_3_flag == 1 {
.         global regvars ""baselinecontrols" "indices_ppp""
.         do "$do_dir/UCT_UnmatchedHH_Balance.do" // Balance of these household
> s on baseline characteristics

. set more off

. sysdir set PERSONAL "${ado_dir}"

. 
. /* NOTE: Village fixed effects won't work here because of the small number of
>  observations */
. 
. foreach thisvarlist in $regvars {
  2. 
. *** CREATE EMPTY TABLE ***
.         clear all
  3.         set obs 10
  4.         gen fakex = 1
  5.         gen fakey = 1
  6.         local totalcols = 3
  7.         forvalues x = 1/`totalcols' {
  8.                 eststo col`x': reg fakex fakey
  9.         }
 10. 
. 
. *** TRACK ITERATIONS ***
.         local count = 1
 11.         local countse = `count'+ 1
 12.         local statnames ""
 13.         local varlabels ""
 14.         
.         
. *** DATASET *** 
.         use "$data_dir/UCT_UNMATCHED.dta",clear
 15.         drop if baselinedate == .
 16.         gen include = 1
 17.         replace include = 0 if maleres == 1
 18.         drop if purecontrol == 1
 19.         tempfile usedata
 20.         save `usedata'
 21. 
. 
. *** REGRESSION TABLES *** 
.         foreach var in $`thisvarlist' {
 22.         
.                 use `usedata', clear
 23.                 if "`thisvarlist'" == "indices_ppp" local thisvar "`var'0"
 24.                 else local thisvar "`var'"
 25.                 
.                 // Weighting for Psychological Outcomes
.                 if "`var'" == "psy_index_z" replace include = 1 if maleres ==
>  1
 26.                 
.                 *** COLUMN 1: SAMPLE MEAN ***
.                 sum `thisvar' if unmatched == 0 & include == 1  
 27.                 estadd local thisstat`count' = string(`r(mean)', "%9.2f") 
> : col1                
 28.                 estadd local thisstat`countse' = "(" + string(`r(sd)', "%9
> .2f") + ")" : col1
 29.                 esttab col1, stats(thisstat`count' thisstat`countse')
 30.                 
.                 *** COLUMN 2: UNMATCHED ***
.                 reg `thisvar' unmatched if include == 1, cluster(surveyid) 
 31.                 pstar unmatched
 32.                 estadd local thisstat`count' = "`r(bstar)'": col2
 33.                 estadd local thisstat`countse' = "`r(sestar)'": col2
 34.                 
.                 *** COLUMN 3: OBSERVATIONS ***
.                 sum `thisvar' if include == 1
 35.                 local thisN = `r(N)'
 36.                 estadd scalar thisstat`count' = `thisN': col3
 37.                 
.                 *** ITERATE ***
.                 local thisvarlabel: variable label `thisvar'
 38.                 local varlabels "`varlabels' "`thisvarlabel'" " " "
 39.                 local statnames "`statnames' thisstat`count' thisstat`coun
> tse'"
 40.                 local count = `count' + 2
 41.                 local countse = `count' + 1
 42.         }
 43.         
. *** JOINT ESTIMATION ROW ***
. 
.         use `usedata', clear
 44.         drop if purecontrol == 1
 45.         // Store for suest
.         local suestcount = 1
 46.         local suest1 "suest " 
 47.         foreach var in $`thisvarlist' {
 48.                 if "`thisvarlist'" == "indices_ppp" local thisvar "`var'0"
 49.                 else local thisvar "`var'"
 50.                 
.                 // Weighting for Psychological Outcomes
.                 if "`var'" == "psy_index_z" replace include = 1 if maleres ==
>  1
 51.                 else replace include = 0 if maleres == 1
 52.                 
.                 reg `thisvar' unmatched if include == 1
 53.                 est store spec1_`suestcount'
 54.                 local suest1 "`suest1' spec1_`suestcount'"
 55.                 local ++suestcount
 56.         }
 57.         
.         // SUR
.         `suest1', cluster(surveyid)
 58.         test unmatched
 59.         pstar, p(`r(p)') pstar pnopar
 60.         local testp "`r(pstar)'"
 61.         estadd local testp "`testp'": col2

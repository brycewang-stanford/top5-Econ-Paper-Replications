 70.                         reg `var'1 treatXfemalerecXmarried treatXmalerecXm
> arried treatXsinglerec spillover if `gender' == 1
 71.                         est store spec5_`suestcount'
 72.                         local suest5 "`suest5' spec5_`suestcount'"
 73.                         local ++suestcount
 74.                 }
 75. 
.                 // SUR
.                 `suest1', cluster(surveyid) 
 76.                 test treatXfemalerecXmarried
 77.                 pstar, p(`r(p)') pstar pnopar
 78.                 local testp "`r(pstar)'"
 79.                 estadd local testp "{`testp'}": col2
 80. 
.                 `suest2', cluster(surveyid) 
 81.                 test treatXmalerecXmarried
 82.                 pstar, p(`r(p)') pstar pnopar
 83.                 local testp "`r(pstar)'"
 84.                 estadd local testp "{`testp'}": col3
 85. 
.                 `suest3', cluster(surveyid) 
 86.                 test treatXfemalerecXmarried
 87.                 pstar, p(`r(p)') pstar pnopar
 88.                 local testp "`r(pstar)'"
 89.                 estadd local testp "{`testp'}": col4
 90. 
.                 `suest4', cluster(village) 
 91.                 test treatXfemalerecXmarried
 92.                 pstar, p(`r(p)') pstar pnopar
 93.                 local testp "`r(pstar)'"
 94.                 estadd local testp "{`testp'}": col5
 95. 
.                 `suest5', cluster(village) 
 96.                 test treatXmalerecXmarried
 97.                 pstar, p(`r(p)') pstar pnopar
 98.                 local testp "`r(pstar)'"
 99.                 estadd local testp "{`testp'}": col6
100. 
.                 local statnames "`statnames' testp" 
101.                 local varlabels "`varlabels' "\midrule Joint test (\emph{p
> }-value)" " 
102. 
. 
. 
.                 *** OUTPUT ***
.                 esttab col* using "$output_dir/`thisvarlist'_genderrestricted
> _`gender'.tex", replace cells(none) booktabs nonotes compress  alignment(SSSS
> SSc) mtitle("\specialcell{Control\\mean (SD)}" "\specialcell{Female\\recipien
> t\\(within villages)}" "\specialcell{Male\\recipient\\(within villages)}" "\s
> pecialcell{Female vs.\\male recipient\\(within villages)}" "\specialcell{Fema
> le\\recipient\\(across villages)}" "\specialcell{Male\\recipient\\(across vil
> lages)}" "N" ) stats(`statnames', labels(`varlabels') )
103.         }
104. }

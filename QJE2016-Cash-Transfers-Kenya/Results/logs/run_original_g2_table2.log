> rge spillover fev*, options(cluster(surveyid)) iter($stepdowniternow) control
> stems(_miss0 _full0)
 46.                 mat C = r(p)
 47.                 stepdown reg (`thisvarlist1') treatXlarge spillover fev*, 
> options(cluster(surveyid)) iter($stepdowniternow) controlstems(_miss0 _full0)
 48.                 mat D = r(p)
 49.         }
 50. 
. 
. *** REGRESSIONS FOR EACH ENDLINE OUTCOME ***
.         foreach var in $`thisvarlist' {
 51. 
.                 use `usedata', clear
 52.                 local thisvarname "`var'1"
 53. 
.                 // The Psych Index is individual level, so it is treated diff
> erent from other variables in the index list.
.                 if "`var'" == "psy_index_z" replace include = 1 if maleres ==
>  1
 54. 
.                 *** WEIGHTS FOR OUTCOMES AT THE INDIVIDUAL LEVEL ***
.                 bysort surveyid: egen weight = count(`thisvarname') if includ
> e == 1
 55.                 bysort village: egen weight2 = count(`thisvarname') if inc
> lude == 1
 56.                 replace weight2 =  1 / weight2 / weight
 57.                 replace weight = 1 / weight
 58. 
.                 *** COLUMN 1: CONTROL MEAN ***
.                 sum `thisvarname' if spillover & include == 1

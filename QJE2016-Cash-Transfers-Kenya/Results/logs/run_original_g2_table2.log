. version 13.1

. set more off

. sysdir set PERSONAL "${ado_dir}"

. 
. foreach thisvarlist in $regvars {
  2. 
. *** CREATE EMPTY TABLE ***
.         clear all
  3.         set obs 10
  4.         gen x = 1
  5.         gen y = 1
  6. 
.         forvalues x = 1/6 {
  7.                 eststo col`x': reg x y

. 
. *** FWER-ADJUSTED P-VALUES USING STEPDOWN ***
.         if "`thisvarlist'" == "indices_ppp" {
 30. 
.                 use `usedata', clear
 31.                 // Varlist for stepdown. Use missing indicator approach wi
> th controlstems option
.                 local thisvarlist1 ""
 32.                 local thisvarlist0 ""
 33.                 foreach var in $`thisvarlist' {
 34.                         if "`var'" ~= "psy_index_z" replace `var'1 = . if 
> maleres == 1
 35.                         local thisvarlist1 "`thisvarlist1' `var'1"
 36.                         local thisvarlist0 "`thisvarlist0' `var'_full0 `va
> r'_miss0"
 37.                         gen `var'1_full0 = `var'_full0
 38.                         gen `var'1_miss0 = `var'_miss0
 39.                 }
 40. 
.                 // Stepdown
.                 set seed 1073741823
 41.                 stepdown reg (`thisvarlist1') treat fev*, options(cluster(
> surveyid)) iter($stepdowniternow) controlstems(_miss0 _full0)
 42.                 mat A = r(p)
 43.                 stepdown reg (`thisvarlist1') treatXfemalerecXmarried trea
> tXsinglerec spillover fev*, options(cluster(surveyid)) iter($stepdowniternow)
>  controlstems(_miss0 _full0)
 44.                 mat B = r(p)

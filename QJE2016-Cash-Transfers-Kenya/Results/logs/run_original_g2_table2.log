111.         local suest1 "suest "
112.         local suest2 "suest "
113.         local suest3 "suest "
114.         local suest4 "suest "
115. 
.         foreach var in $`thisvarlist' {
116.                 local thisvarname "`var'1"
117. 
.                 if `hhcase' == 1 & "`var'" == "psy_index_z" replace include =
>  1 if maleres == 1
118.                 if `hhcase' == 1 & "`var'" ~= "psy_index_z" replace includ
> e = 0 if maleres == 1
119. 
.                 cap drop weight weight2
120.                 bysort surveyid: egen weight = count(`thisvarname') if inc
> lude == 1
121.                 bysort village: egen weight2 = count(`thisvarname') if inc
> lude == 1
122.                 replace weight2 =  1 / weight2 / weight
123.                 replace weight = 1 / weight
124. 
.                 reg `thisvarname' treat fev* `var'_full0 `var'_miss0 $theseco
> ntrol if include == 1 `thisweighting'
125.                 est store spec1_`suestcount'

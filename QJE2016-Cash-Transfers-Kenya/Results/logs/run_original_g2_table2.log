 14. 
. 
. *** DENOTE HOUSEHOLD VS INDIVIDUAL OUTCOMES ***
. 
.         if "`thisvarlist'" == "psyvars" | "`thisvarlist'" == "psyvars_weighte
> d" | "`thisvarlist'" == "psyvars_weighted2" local hhcase = 0
 15.         else local hhcase = 1
 16. 
.         // weighting will be by the number of observations per household, as 
> this is not necessarily balanced.
.         if "`thisvarlist'" == "indices_weighted" | "`thisvarlist'" == "psyvar
> s_weighted" local thisweighting "[aw=weight]"
 17.         else if "`thisvarlist'" == "psyvars_weighted2" local thisweighting
>  "[aw=weight2]"

. *** JOINT ESTIMATION ROW ***
. 
.         use `usedata', clear
 98.         
.         local suestcount = 1
 99.         local suest1 "suest " 
100.         local suest2 "suest " 
101.         local suest3 "suest " 
102.         local suest4 "suest " 
103.         
.         foreach var in $`thisvarlist' {         
104.                 if "`thisvarlist'" == "baselinecontrols" local thisvarname
>  "`var'"
105.                 else local thisvarname "`var'0"
106.                 
.                 if "`var'" == "psy_index_z" replace include = 1 if maleres ==
>  1
107.                 else replace include = 0 if maleres == 1
108.         
.                 reg `thisvarname' treat fev* if include == 1
109.                 est store spec1_`suestcount'
110.                 local suest1 "`suest1' spec1_`suestcount'"
111.                 reg `thisvarname' treatXfemalerecXmarried treatXsinglerec 
> spillover fev* if include == 1
112.                 est store spec2_`suestcount'
113.                 local suest2 "`suest2' spec2_`suestcount'"
114.                 reg `thisvarname' treatXmonthlyXsmall treatXlarge spillove
> r fev* if include == 1
115.                 est store spec3_`suestcount'
116.                 local suest3 "`suest3' spec3_`suestcount'"
117.                 reg `thisvarname' treatXlarge spillover fev* if include ==
>  1
118.                 est store spec4_`suestcount'
119.                 local suest4 "`suest4' spec4_`suestcount'"
120.                 local ++suestcount
121.         }
122.         
.         // SUR
.         `suest1', cluster(surveyid) 
123.         test treat
124.         pstar, p(`r(p)') pstar pnopar
125.         local testp "`r(pstar)'"
126.         estadd local testp "`testp'": col2
127.         
.         `suest2', cluster(surveyid) 
128.         test treatXfemalerecXmarried
129.         pstar, p(`r(p)') pstar pnopar
130.         local testp "`r(pstar)'"
131.         estadd local testp "`testp'": col3
132.         
.         `suest3', cluster(surveyid) 
133.         test treatXmonthlyXsmall
134.         pstar, p(`r(p)') pstar pnopar
135.         local testp "`r(pstar)'"
136.         estadd local testp "`testp'": col4
137.         
.         `suest4', cluster(surveyid) 
138.         test treatXlarge
139.         pstar, p(`r(p)') pstar pnopar
140.         local testp "`r(pstar)'"
141.         estadd local testp "`testp'": col5
142.         
.         local statnames "`statnames' testp" 
143.         local varlabels "`varlabels' "\midrule Joint test (\emph{p}-value)
> " " 
144.         
.         
. esttab col* using "$output_dir/baseline_`thisvarlist'_maintable.tex",  cells(

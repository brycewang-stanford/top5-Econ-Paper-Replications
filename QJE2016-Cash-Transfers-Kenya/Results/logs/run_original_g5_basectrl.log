> rge spillover fev*, options(cluster(surveyid)) iter($stepdowniternow) control
> stems(_miss0 _full0)
 46.                 mat C = r(p)
 47.                 stepdown reg (`thisvarlist1') treatXlarge spillover fev*, 
> options(cluster(surveyid)) iter($stepdowniternow) controlstems(_miss0 _full0)
 48.                 mat D = r(p)
 49.         }
 50. 
. 
. *** REGRESSIONS FOR EACH ENDLINE OUTCOME ***
.         foreach var in $`thisvarlist' {
 51. 
.                 use `usedata', clear
 52.                 local thisvarname "`var'1"
 53. 
.                 // The Psych Index is individual level, so it is treated diff
> erent from other variables in the index list.
.                 if "`var'" == "psy_index_z" replace include = 1 if maleres ==
>  1
 54. 
.                 *** WEIGHTS FOR OUTCOMES AT THE INDIVIDUAL LEVEL ***
.                 bysort surveyid: egen weight = count(`thisvarname') if includ
> e == 1
 55.                 bysort village: egen weight2 = count(`thisvarname') if inc
> lude == 1
 56.                 replace weight2 =  1 / weight2 / weight
 57.                 replace weight = 1 / weight
 58. 
.                 *** COLUMN 1: CONTROL MEAN ***
.                 sum `thisvarname' if spillover & include == 1
 59.                 estadd local thisstat`count' = string(`r(mean)', "%9.2f") 
> : col1
 60.                 estadd local thisstat`countse' = "(" + string(`r(sd)', "%9
> .2f") + ")" : col1
 61. 
.                 *** COLUMN 2: TREATMENT EFFECT ***
.                 areg `thisvarname' treat `var'_full0 `var'_miss0 $thesecontro
> l if include == 1 `thisweighting', absorb(village) cluster(surveyid)
 62.                 pstar treat
 63.                 estadd local thisstat`count' = "`r(bstar)'": col2
 64.                 estadd local thisstat`countse' = "`r(sestar)'": col2
 65. 
.                 *** COLUMN 3: FEMALE RECIPIENT ***
.                 areg `thisvarname' treatXfemalerecXmarried treatXsinglerec sp
> illover `var'_full0 `var'_miss0 $thesecontrol if include == 1 `thisweighting'
> , absorb(village) cluster(surveyid)
 66.                 pstar treatXfemalerecXmarried
 67.                 estadd local thisstat`count' = "`r(bstar)'": col3
 68.                 estadd local thisstat`countse' = "`r(sestar)'": col3
 69. 
.                 *** COLUMN 4: MONTHLY TRANSFER ***
.                 areg `thisvarname' treatXmonthlyXsmall treatXlarge spillover 
> `var'_full0 `var'_miss0 $thesecontrol if include == 1 `thisweighting', absorb
> (village) cluster(surveyid)
 70.                 pstar treatXmonthlyXsmall
 71.                 estadd local thisstat`count' = "`r(bstar)'": col4
 72.                 estadd local thisstat`countse' = "`r(sestar)'": col4
 73. 
.                 *** COLUMN 5: LARGE TRANSFER ***
.                 areg `thisvarname' treatXlarge spillover `var'_full0 `var'_mi
> ss0 $thesecontrol if include == 1 `thisweighting', absorb(village) cluster(su
> rveyid)
 74.                 pstar treatXlarge
 75.                 estadd local thisstat`count' = "`r(bstar)'": col5
 76.                 estadd local thisstat`countse' = "`r(sestar)'": col5
 77. 
.                 *** COLUMN 6: N ***
.                 sum `thisvarname' if include == 1
 78.                 local thisN = `r(N)'
 79.                 estadd scalar thisstat`count' = `thisN': col6
 80. 
.                 *** STORE VARIABLE LABELS AND ITERATE ***
.                 if "`thisvarlist'" ~= "indices_ppp"  {
 81.                         local thisvarlabel: variable label `thisvarname'
 82.                         local varlabels "`varlabels' "`thisvarlabel'" " " 
> "
 83.                         local statnames "`statnames' thisstat`count' thiss
> tat`countse'"
 84. 
.                         local count = `count' + 2
 85.                         local countse = `count' + 1
 86.                 }
 87.                 else { // ADD FROM STEPDOWN MATRICIES IF USING FWER ADJUST
> ED P-VALUES
 88.                         local countp = `countse' +1
 89.                         local thisp1 = A[1,`varcount']
 90.                         pstar, p(`thisp1') pbracket pstar
 91.                         estadd local thisstat`countp' = "`r(pstar)'": col2
 92. 
.                         local thisp2 = B[1,`varcount']
 93.                         pstar, p(`thisp2') pbracket pstar
 94.                         estadd local thisstat`countp' = "`r(pstar)'": col3
 95. 
.                         local thisp3 = C[1,`varcount']
 96.                         pstar, p(`thisp3') pbracket pstar
 97.                         estadd local thisstat`countp' = "`r(pstar)'": col4
 98. 
.                         local thisp4 = D[1,`varcount']
 99.                         pstar, p(`thisp4') pbracket pstar
100.                         estadd local thisstat`countp' = "`r(pstar)'": col5
101. 
.                         local thisvarlabel: variable label `thisvarname'
102.                         local varlabels "`varlabels' "`thisvarlabel'" " " 
> " " "
103.                         local statnames "`statnames' thisstat`count' thiss
> tat`countse' thisstat`countp'"
104. 
.                         local count = `count' + 3
105.                         local countse = `count' + 1
106.                         local ++varcount
107.                 }
108.         }
109. 
. 
. *** JOINT ESTIMATION ROW ***
.         use `usedata', clear
110.         local suestcount = 1
111.         local suest1 "suest "
112.         local suest2 "suest "
113.         local suest3 "suest "
114.         local suest4 "suest "
115. 
.         foreach var in $`thisvarlist' {
116.                 local thisvarname "`var'1"
117. 
.                 if `hhcase' == 1 & "`var'" == "psy_index_z" replace include =
>  1 if maleres == 1
118.                 if `hhcase' == 1 & "`var'" ~= "psy_index_z" replace includ
> e = 0 if maleres == 1
119. 
.                 cap drop weight weight2
120.                 bysort surveyid: egen weight = count(`thisvarname') if inc
> lude == 1
121.                 bysort village: egen weight2 = count(`thisvarname') if inc
> lude == 1
122.                 replace weight2 =  1 / weight2 / weight
123.                 replace weight = 1 / weight
124. 
.                 reg `thisvarname' treat fev* `var'_full0 `var'_miss0 $theseco
> ntrol if include == 1 `thisweighting'
125.                 est store spec1_`suestcount'
126.                 local suest1 "`suest1' spec1_`suestcount'"
127.                 reg `thisvarname' treatXfemalerecXmarried treatXsinglerec 
> spillover fev* `var'_full0 `var'_miss0 $thesecontrol if include == 1 `thiswei
> ghting'
128.                 est store spec2_`suestcount'
129.                 local suest2 "`suest2' spec2_`suestcount'"
130.                 reg `thisvarname' treatXmonthlyXsmall treatXlarge spillove
> r fev* `var'_full0 `var'_miss0 $thesecontrol if include == 1 `thisweighting'
131.                 est store spec3_`suestcount'
132.                 local suest3 "`suest3' spec3_`suestcount'"
133.                 reg `thisvarname' treatXlarge spillover fev* `var'_full0 `
> var'_miss0 $thesecontrol if include == 1 `thisweighting'
134.                 est store spec4_`suestcount'
135.                 local suest4 "`suest4' spec4_`suestcount'"
136.                 local ++suestcount
137.         }
138. 
.         // SUR
.         `suest1', cluster(surveyid)
139.         test treat
140.         pstar, p(`r(p)') pstar pnopar
141.         local testp "`r(pstar)'"
142.         estadd local testp "`testp'": col2
143. 
.         `suest2', cluster(surveyid)
144.         test treatXfemalerecXmarried
145.         pstar, p(`r(p)') pstar pnopar
146.         local testp "`r(pstar)'"
147.         estadd local testp "`testp'": col3
148. 
.         `suest3', cluster(surveyid)
149.         test treatXmonthlyXsmall
150.         pstar, p(`r(p)') pstar pnopar
151.         local testp "`r(pstar)'"
152.         estadd local testp "`testp'": col4
153. 
.         `suest4', cluster(surveyid)
154.         test treatXlarge
155.         pstar, p(`r(p)') pstar pnopar
156.         local testp "`r(pstar)'"
157.         estadd local testp "`testp'": col5
158. 
.         local statnames "`statnames' testp"
159.         local varlabels "`varlabels' "\midrule Joint test (\emph{p}-value)
> " "
160. 
.         local controllab "$controllabel"
161.         esttab col* using "$output_dir/`thisvarlist'_maintable`controllab'
> .tex",  cells(none) booktabs nonotes compress replace alignment(SSSSSc) mtitl
> e("\specialcell{Control\\mean (SD)}" "\specialcell{Treatment\\effect}" "\spec
> ialcell{Female\\recipient}" "\specialcell{Monthly\\transfer}" "\specialcell{L
> arge\\transfer}" "N" ) stats(`statnames', labels(`varlabels') )
162. }

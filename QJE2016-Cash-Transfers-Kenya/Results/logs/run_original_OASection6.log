> age)

. 
. *** COLLAPSE BY VILLAGE AND GENERATE AVERAGE TOTAL WEALTH VARIABLE ***
. collapse total_hh pct_surveyed pct_treated asset_total_ppp0 total_transfers, 
> by(village metalroof)

. recode asset_total_ppp0 0 = .
(0 changes made to asset_total_ppp0)

. bysort village: gen total_wealth = (pct_surveyed * total_hh * asset_total_ppp
> 0[1]) + ((1 - pct_surveyed) * total_hh * asset_total_ppp0[2])
(62 missing values generated)

. collapse total_hh pct_surveyed pct_treated total_wealth total_transfers, by(v
